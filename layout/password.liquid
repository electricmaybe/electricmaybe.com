<!doctype html>
<html class="no-js scroll-smooth scroll-pt-16" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    {%- if page_description != blank -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- elsif settings.share_description != blank -%}
      <meta name="description" content="{{ settings.share_description | escape }}">
    {%- endif -%}

    {%- liquid
        render '_meta-sharing'
        render '_head-seo'
        render '_head-json-ld'
        render '_head-typography'
        render '_head-style'
      -%}

    {% # theme-check-disable AssetPreload %}
    {{ 'index.js' | asset_url | preload_tag: as: 'script' }}
    {{ 'style.css' | asset_url | preload_tag: as: 'stylesheet' }}
    {% # theme-check-enable AssetPreload %}

    {{ 'style.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>
  <body class="password">
    <a class="skip-to-content-link button sr-only" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>
    <main id="MainContent" class="password-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
