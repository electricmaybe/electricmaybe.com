{% layout none %}

<!doctype html>
<html class="no-js scroll-smooth scroll-pt-16" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">

    {%- assign formatted_initial_value = gift_card.initial_value
      | money_without_trailing_zeros: gift_card.currency
      | strip_html
    -%}
    <title>{{ 'gift_cards.issued.title' | t: value: formatted_initial_value, shop: shop.name }}</title>

    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {{ content_for_header }}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" rel="nofollow" crossorigin>

    {%- unless settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" rel="nofollow" crossorigin>
    {%- endunless -%}
    {% # theme-check-disable AssetPreload %}
    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_heading_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_heading_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {% # theme-check-enable AssetPreload %}

    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif -%}

    {%- render '_head-style' -%}
    {{ 'style.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body>
    <main id="MainContent" class="container mt-12 text-center" role="main" tabindex="-1">
      <div class="flex flex-col items-center gift-card__image-wrapper">
        <img
          class="gift-card__image"
          src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
          alt=""
          loading="lazy"
          height="{{ 570 | divided_by: 1.5 }}"
          width="570"
        >
        <div class="mt-6 gift-card__price text-2xl/solid">
          <h1 class="text-heading">
            {% if settings.currency_code_enabled %}
              {{ gift_card.balance | money_with_currency }}
            {% else %}
              {{ gift_card.balance | money }}
            {% endif %}
          </h1>
          {%- if gift_card.enabled == false or gift_card.expired -%}
            <p class="badge badge--{{ settings.sold_out_badge_color_scheme }}">{{ 'gift_cards.issued.expired' | t }}</p>
          {%- endif -%}
        </div>
        {% if gift_card.expires_on %}
          {%- assign gift_card_expiration_date = gift_card.expires_on | date: '%B %e, %Y' -%}
          <p class="gift-card__text">
            {{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiration_date }}
          </p>
        {% endif %}
      </div>
      {%- if settings.logo != blank -%}
        <div class="flex items-center justify-center mt-4">
        {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
        {{ settings.logo | image_url: width: 240 | image_tag: class: 'gift-card__image w-16', alt: logo_alt }}
        </div>
      {%- endif -%}
      <h2 class="mt-6 text-lg/solid" itemtype="http://schema.org/Organization">{{ shop.name }}</h2>
      <div class="gift-card__text-wrapper mt-2">
        <p class="gift-card__text">{{ 'gift_cards.issued.how_to_use_gift_card' | t }}</p>
      </div>
      <input class="hidden gift-card__number" value="{{ gift_card.code | format_code }}">
      <p id="gift-card-code">{{ gift_card.code | format_code }}</p>
      <div class="flex justify-center my-6 gift-card__qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}" class="gift_card__apple-wallet no-print">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            width="120"
            height="40"
            alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
            loading="lazy"
          >
        </a>
      {%- endif -%}
      <div class="gift-card__buttons no-print">
        <div class="flex justify-center gap-6">
          {%- render 'a--button',
            tag: 'button',
            style: 'secondary',
            translation: 'gift_cards.issued.copy_code',
            class: 'gift-card__copy-link'
          -%}
          {%- render 'a--button',
            tag: 'a',
            style: 'primary',
            url: shop.url,
            translation: 'gift_cards.issued.shop_link'
          -%}
        </div>
        <span
          class="inline-flex items-center hidden gap-2 p-4 mt-4 rounded-sm gift-card__copy-success form__message bg-accent1 text-accent1_fg"
          role="status"
        ></span>
        <template>
          {%- render 'a--icon', icon: 'checkmark' -%}
          {{ 'gift_cards.issued.copy_code_success' | t }}
        </template>
      </div>

      <footer class="mt-6 giftcard__footer">
        {%- if gift_card.pass_url -%}
          <a class="add-to-apple-wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              width="120"
              height="40"
              alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </footer>
    </main>

    <div hidden>
      <span id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</span>
    </div>
  </body>
</html>

<script>
  var string = { qrImageAlt: {{ 'gift_cards.issued.qr_image_alt' | t | json }} };
  document.addEventListener('DOMContentLoaded', function() {
   new QRCode( document.querySelector('.gift-card__qr-code'), {
    text: document.querySelector('.gift-card__qr-code').dataset.identifier,
    width: 120,
    height: 120,
    imageAltText: string.qrImageAlt
    });
  });

  var template = document.getElementsByTagName("template")[0];
  var clonedTemplate = template.content.cloneNode(true);

  var successMessage = document.querySelector('.gift-card__copy-success')

  var isMessageDisplayed = false
  document
  .querySelector('.gift-card__copy-link')
  .addEventListener('click', () => {
    navigator.clipboard.writeText(document.querySelector('.gift-card__number').value).then(function () {
      if (!isMessageDisplayed) {
        successMessage.appendChild(clonedTemplate);
        successMessage.classList.remove('hidden')
        isMessageDisplayed = true
      }
    });
  });
</script>
