{%- liquid
  assign heading = section.settings.cart_header | strip_html
  assign cart_recommendations_heading = section.settings.cart_recommendations_heading
  assign cart_upsell_success_label = section.settings.cart_upsell_success_label
  assign cart_upsell_error_label = section.settings.cart_upsell_error_label
  assign cart_trust_title = section.settings.cart_trust_title
  assign cart_trust_subtext = section.settings.cart_trust_subtext
  if cart.item_count > 0 and settings.show_cart_item_quantity
    assign heading = heading | append: '<sup>' | append: cart.item_count | append: '</sup>'
  endif
  capture content
    render 'cart--main', render_context: 'drawer', cart_recommendations_heading: cart_recommendations_heading, cart_upsell_success_label: cart_upsell_success_label, cart_upsell_error_label: cart_upsell_error_label, cart_trust_title: cart_trust_title, cart_trust_subtext: cart_trust_subtext
  endcapture
  render 'm--drawer', heading: heading, content: content, id: 'cart-drawer', positionMobile: 'right', positionDesktop: 'right', show_close_button: false, properties: 'data-load-on-event="cart:added"'
-%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
