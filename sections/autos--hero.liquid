{%- liquid
  assign overlay_header_active = false
  if section.settings.overlay_header and section.index == 1
    assign overlay_header_active = true
  endif

  assign desired_brands_raw = 'Abarth||Aiways||Alfa Romeo||Alpine||Audi||BMW||BYD||Bentley||Cadillac||Chery||Chevrolet||Citroën||Cupra||DS||Dacia||Dongfeng||Ferrari||Fiat||Fisker||Ford||GWM||Genesis||Honda||Hongqi||Hyundai||JAC||Jaecoo||Jaguar||Jeep||KGM||Kia||LEVC||Lancia||Land Rover||Landrover / Range Rover||Leapmotor||Lexus||Lightyear||Lotus||Lucid||Lynk&Co||MG||Maserati||Mazda||Mercedes||Mini||Mitsubishi||NIO||Nissan||Opel||Peugeot||Polestar||Porsche||Range Rover||Renault||Rolls Royce||SEAT||SSANGYONG||Seres||Skoda||Smart||Sono||SsangYong||Subaru||Suzuki||Tesla||Toyota||Vauxhall||VinFast||Volkswagen||Volvo||Voyah||XPENG||Zeekr'
  assign desired_brands = desired_brands_raw | split: '||'
  assign store_brand_hits_raw = ''
  assign brand_model_pairs_raw = ''

  for collection in collections
    assign title_downcase = collection.title | downcase
    for desired_brand in desired_brands
      assign desired_brand_downcase = desired_brand | downcase
      if title_downcase contains desired_brand_downcase
        if store_brand_hits_raw == ''
          assign store_brand_hits_raw = desired_brand
        else
          assign store_brand_hits_raw = store_brand_hits_raw | append: '||' | append: desired_brand
        endif

        assign model_clean = collection.title
        assign model_clean = model_clean | replace: 'Charging cable', '' | replace: 'Charging Cable', '' | strip
        assign model_clean = model_clean | replace: 'Charging table', '' | replace: 'charging cable', '' | strip
        assign model_clean = model_clean | replace: desired_brand, '' | strip
        assign model_clean = model_clean | replace: '  ', ' ' | replace: '  ', ' ' | strip
        assign model_clean = model_clean | replace_first: '-', '' | replace_first: '–', '' | strip
        if model_clean != blank
          if brand_model_pairs_raw == ''
            assign brand_model_pairs_raw = desired_brand | append: '||' | append: model_clean | append: '||' | append: collection.url
          else
            assign brand_model_pairs_raw = brand_model_pairs_raw | append: '|||' | append: desired_brand | append: '||' | append: model_clean | append: '||' | append: collection.url
          endif
        endif
      endif
    endfor
  endfor

  assign filtered_brand_list = store_brand_hits_raw | split: '||' | uniq | sort
  assign brand_model_pairs = brand_model_pairs_raw | split: '|||'
-%}

{%- capture content -%}
  {%- render 'm--autos-hero',
    heading: section.settings.heading,
    body: section.settings.body,
    brand_label: section.settings.brand_label,
    model_label: section.settings.model_label,
    search_button_label: section.settings.search_button_label,
    filtered_brand_list: filtered_brand_list,
    brand_model_pairs: brand_model_pairs
  -%}
{%- endcapture -%}

{%- render 'm--hero-wrapper',
  section: section,
  content: content,
  overlay_header_active: overlay_header_active
-%}

{% javascript %}
  const autosHeroWrappers = document.querySelectorAll('[data-brand-model]');

  autosHeroWrappers.forEach((wrapper) => {
    const brandSelect = wrapper.querySelector('[data-brand-select]');
    const modelSelect = wrapper.querySelector('[data-model-select]');
    const searchButton = wrapper.querySelector('[data-search-button]');
    if (!brandSelect || !modelSelect) return;

    let pairs = [];
    try {
      pairs = JSON.parse(wrapper.dataset.brandModelPairs || '[]');
    } catch (error) {
      pairs = [];
    }

    const modelMap = pairs.reduce((acc, pair) => {
      if (!pair || !pair.brand || !pair.model || !pair.url) return acc;
      if (!acc[pair.brand]) acc[pair.brand] = [];
      acc[pair.brand].push({ label: pair.model, url: pair.url });
      return acc;
    }, {});

    const placeholder = modelSelect.dataset.placeholder || '';

    const resetModels = () => {
      modelSelect.innerHTML = '';
      const option = document.createElement('option');
      option.value = '';
      option.textContent = placeholder;
      option.disabled = true;
      option.selected = true;
      modelSelect.appendChild(option);
      modelSelect.disabled = true;
      modelSelect.classList.add('text-primary/30');
      if (searchButton) searchButton.disabled = true;
    };

    const populateModels = (brand) => {
      resetModels();
      if (!brand || !modelMap[brand]) return;
      modelMap[brand].forEach((model) => {
        const option = document.createElement('option');
        option.value = model.label;
        option.textContent = model.label;
        option.dataset.url = model.url;
        modelSelect.appendChild(option);
      });
      modelSelect.disabled = false;
      modelSelect.classList.remove('text-primary/30');
    };

    resetModels();
    brandSelect.addEventListener('change', (event) => {
      populateModels(event.target.value);
    });
    modelSelect.addEventListener('change', (event) => {
      const selectedOption = event.target.selectedOptions[0];
      const targetUrl = selectedOption?.dataset?.url;
      if (!searchButton) return;
      if (targetUrl) {
        searchButton.disabled = false;
        searchButton.dataset.targetUrl = targetUrl;
      } else {
        searchButton.disabled = true;
      }
    });
    if (searchButton) {
      searchButton.addEventListener('click', () => {
        const targetUrl = searchButton.dataset.targetUrl;
        if (targetUrl) window.location.href = targetUrl;
      });
    }
  });
{% endjavascript %}

