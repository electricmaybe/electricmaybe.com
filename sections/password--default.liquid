<div class="container px-4 mx-auto my-8">
  <div class="max-w-md mx-auto">
    {%- if settings.logo != blank -%}
      {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
      {%- assign logo_height = section.settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
      {{
        settings.logo
        | image_url: width: section.settings.width
        | image_tag:
          class: 'mx-auto mb-4',
          widths: '50, 100, 150, 200, 250, 300, 400, 500',
          height: logo_height,
          width: section.settings.logo_width,
          alt: logo_alt
      }}
    {%- endif -%}
    {%- if section.settings.show_shop_name %}
      <p class="mb-4 text-center text-2xl/solid">{{ shop.name }}</p>
    {%- endif -%}
    {% if section.settings.heading != blank %}
      <h1 class="mb-4 font-medium text-center text-2xl/solid">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="mb-6 text-center text-lg/solid">{{ section.settings.subheading }}</p>
    {% endif %}

    <p class="mb-6 text-center text-lg/solid">{{ shop.password_message }}</p>

    {%- form 'storefront_password', class: 'password-form flex flex-col space-y-4' -%}
      {%- liquid
        assign label = 'general.password_page.login_form_password_label' | t
        assign placeholder = 'general.password_page.login_form_password_placeholder' | t
      -%}

      {%- render 'a--input',
        type: 'password',
        name: 'password',
        id: 'password',
        class: 'w-full',
        required: true,
        wrapper_class: 'flex flex-col',
        placeholder: placeholder,
        label: label
      -%}

      {% if section.settings.button_text != blank %}
        {%- render 'a--button',
          tag: 'button',
          label: section.settings.button_text,
          name: 'submit',
          type: 'submit',
          class: 'mt-8'
        -%}
      {% endif %}
    {% endform %}
  </div>
</div>
{% schema %}
{
  "name": "t:global.password",
  "class": "full-spaced-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shop_name",
      "label": "t:global.show_shop_name",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:global.heading",
      "default": "This store is password protected"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:global.heading",
      "default": "Please enter the password below to access the site"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:global.button_label",
      "default": "Submit"
    }
  ]
}
{% endschema %}
