{%- liquid
  assign block_class = 'flex flex-col justify-center items-center gap-y-s-xs '
-%}
<div class="grid md:grid-cols-6 lg:grid-cols-12 text-ui-base px-s-whole py-s-base mx-auto gap-y-s-base">
  <div class="{{ block_class }} text-body md:col-span-4 md:col-start-2 lg:col-span-5 lg:col-start-1">
    {% if section.settings.heading != blank %}
      <h2 class="w-full h1">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body_text != blank %}
      <div class="text-secondary rte">
        {{ section.settings.body_text }}
      </div>
    {% endif %}
  </div>
  {% if section.settings.image_1 != blank %}
    <div class="{{ block_class }} md:col-span-4 md:col-start-2 lg:col-start-8 lg:col-span-5">
      {% render 'a--image', image: section.settings.image_1, cols: 5, object_fit: 'object-contain' %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "History of Voldt",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We are Voldt®"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>Share information about your brand with your customers.</p>"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "History of Voldt"
    }
  ]
}
{% endschema %}
