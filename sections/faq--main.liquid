{%- capture content -%}
  <div class="w-full py-s-sm flex flex-col items-center">
    <div class="w-full max-w-[698px] flex flex-col items-center gap-y-s-base">
      {%- liquid
        if section.settings.heading != blank
          assign heading = section.settings.heading
        else
          assign heading = 'customer.help_center.faq' | t
        endif
        if section.index == 1
          assign tag = 'h1'
        else
          assign tag = 'h2'
        endif
      -%}
      <{{ tag }} class="h1 text-primary text-center w-full">{{ heading }}</{{ tag }}>

      <div class="w-full flex flex-col gap-y-b-sm items-start">
        <p class="text-ui-small font-medium text-primary">{{ 'customer.help_center.faq_search_label' | t }}</p>

        <div class="w-full flex items-center justify-between gap-x-b-base">
          <input
            id="faq-search"
            name="faq-search"
            type="search"
            class="w-full bg-transparent border-0 p-0 m-0 focus:ring-0 focus:outline-hidden text-primary font-normal h5 placeholder:text-primary"
            placeholder="{{ 'customer.help_center.faq_search_prompt' | t }}"
            aria-label="{{ 'customer.help_center.faq_search_aria' | t }}"
          >
          <span class="shrink-0" aria-hidden="true">
            {%- render 'a--icon', icon: 'arrow-right-l', size: '24' -%}
          </span>
        </div>

        <div class="w-full border-b border-primary"></div>
      </div>
    </div>
  </div>

  <div class="lg:max-w-[698px] mx-auto text-ui-base w-full text-left flex flex-col gap-y-b-base px-s-outer lg:px-0">
    {%- assign last_heading_group = 'default' -%}
    <div class="w-full">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- assign last_heading_group = block.id -%}
            <h2 class="faq-heading {% if forloop.first %}mb-6{% else %}mt-18 mb-6{% endif %}" data-faq-group="{{ last_heading_group }}">
              {{ block.settings.heading }}
            </h2>

          {%- when 'faq_list' -%}
            {%- if block.settings.faq_list != blank -%}
              {%- for faq in block.settings.faq_list -%}
                {%- liquid
                  assign answer = faq.answer | metafield_text
                  if answer == blank and faq.answer.value
                    assign answer = faq.answer.value
                  elsif answer == blank and faq.answer != blank
                    assign answer = faq.answer
                  endif
                -%}
                <div class="faq-item" data-faq-group="{{ last_heading_group }}">
                  {%- liquid
                    render 'm--accordion', heading: faq.question, body: answer, title_size: 'h3 font-normal py-b-lg', title_height: 'min-h-14 lg:min-h-18'
                  -%}
                </div>
              {%- endfor -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endcapture -%}
{%- render 'm--wrapper-v2', content: content, container_class: 'px-s-whole flex flex-col w-full place-self-center text-left' -%}

<script>
  (function() {
    const input = document.getElementById('faq-search');
    if (!input) return;
    const items = Array.from(document.querySelectorAll('.faq-item'));
    const headings = Array.from(document.querySelectorAll('.faq-heading'));
    const controller = new AbortController();

    function normalize(str) {
      return (str || '').toString().toLowerCase();
    }

    function filterFaqs() {
      const q = normalize(input.value);
      const active = q.length >= 3;

      items.forEach(item => {
        const text = normalize(item.textContent);
        const match = !active || text.includes(q);
        item.classList.toggle('hidden', !match);
      });

      headings.forEach(h => {
        const group = h.getAttribute('data-faq-group');
        if (!active) {
          h.classList.remove('hidden');
          return;
        }
        const hasVisible = items.some(item => !item.classList.contains('hidden') && item.getAttribute('data-faq-group') === group);
        h.classList.toggle('hidden', !hasVisible);
      });
    }

    let t = 0;
    function onInput() {
      window.clearTimeout(t);
      t = window.setTimeout(filterFaqs, 120);
    }

    input.addEventListener('input', onInput, { signal: controller.signal });
    filterFaqs();
  })();
</script>

