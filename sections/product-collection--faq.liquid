{%- liquid
  assign heading = section.settings.heading
  assign image = section.settings.image
  assign link_url = section.settings.link_url
  assign link_text = section.settings.link_text

  # FAQ sources (in required order):
  # 1) Product metafields: custom.faq_1..custom.faq_4 (each is a single metaobject ref)
  # 2) Product collections metafields: custom.faq1..custom.faq6 (each is a single metaobject ref)
  # 3) Product metafields: custom.shop_faq_1..custom.shop_faq_2 (each is a single metaobject ref)
  #
  # Note: We do NOT implement this logic in s--faq-list; that section stays settings-driven.

  assign product_faq_1 = product.metafields.custom.faq_1.value | default: product.metafields.custom.faq_1
  assign product_faq_2 = product.metafields.custom.faq_2.value | default: product.metafields.custom.faq_2
  assign product_faq_3 = product.metafields.custom.faq_3.value | default: product.metafields.custom.faq_3
  assign product_faq_4 = product.metafields.custom.faq_4.value | default: product.metafields.custom.faq_4

  assign shop_faq_list = shop.metafields.custom.faq.value | default: shop.metafields.custom.faq
  assign shop_faq_1 = product.metafields.custom.shop_faq_1.value | default: product.metafields.custom.shop_faq_1
  assign shop_faq_2 = product.metafields.custom.shop_faq_2.value | default: product.metafields.custom.shop_faq_2

  assign preferred_collection_handle = ''
  if collection != blank
    assign preferred_collection_handle = collection.handle
  endif

  # Pre-check: if none exist, don't render this section at all.
  assign has_any_faq = false
  if product_faq_1 != blank or product_faq_2 != blank or product_faq_3 != blank or product_faq_4 != blank
    assign has_any_faq = true
  endif
  if shop_faq_list != blank or shop_faq_1 != blank or shop_faq_2 != blank
    assign has_any_faq = true
  endif

  assign has_collection_faqs = false
  if has_any_faq == false and product.collections != blank
    for c in product.collections
      assign c_faq_1 = c.metafields.custom.faq1.value | default: c.metafields.custom.faq1
      assign c_faq_2 = c.metafields.custom.faq2.value | default: c.metafields.custom.faq2
      assign c_faq_3 = c.metafields.custom.faq3.value | default: c.metafields.custom.faq3
      assign c_faq_4 = c.metafields.custom.faq4.value | default: c.metafields.custom.faq4
      assign c_faq_5 = c.metafields.custom.faq5.value | default: c.metafields.custom.faq5
      assign c_faq_6 = c.metafields.custom.faq6.value | default: c.metafields.custom.faq6
      if c_faq_1 != blank or c_faq_2 != blank or c_faq_3 != blank or c_faq_4 != blank or c_faq_5 != blank or c_faq_6 != blank
        assign has_collection_faqs = true
        break
      endif
    endfor
  endif

  if has_collection_faqs == true
    assign has_any_faq = true
  endif
-%}

{%- if has_any_faq -%}
  <div class="px-s-whole py-s-base grid grid-cols-1 md:grid-cols-12 w-full gap-y-s-xl md:gap-x-b-base">
    {%- if heading != blank -%}
      <h2 class="display-2 md:col-span-12">
        {{ heading }}
      </h2>
    {%- endif -%}

    <div class="md:col-span-4 space-y-b-base">
      {% render 'a--image', image: image, cols: 4, aspect_ratio: 1.5 %}
      {% if link_url != blank and link_text != blank %}
        <a href="{{ link_url }}" class="text-ui-small flex gap-x-b-base items-center">
          {{ link_text }}
          {% render 'a--icon', icon: 'arrow-right-l' , width: '24px', height: '24px' %}
        </a>
      {% endif %}
    </div>

