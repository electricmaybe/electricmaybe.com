{% comment %}
  @file sections/s--electric-maybe-landing.liquid
  @summary Electric Maybe agency homepage (ported from `old/index.html`). Media lives in `assets/em-*`. Smallchat removed; use Shopify Inbox from admin (Online store chat).
{% endcomment %}

{{ 'em-landing.css' | asset_url | stylesheet_tag }}

<div class="em-landing">
  <div class="em-landing__container">
    <div class="em-landing__title-wrap">
      <img
        src="{{ 'em-logo.svg' | asset_url }}"
        alt="Electric Maybe"
        class="em-landing__logo"
        width="120"
        height="36"
        loading="eager"
        fetchpriority="high"
      >
      <h1>
        <span class="em-landing__line-1">your store needs some</span>
        <span class="em-landing__line-2">electric maybe?</span>
      </h1>
      <p class="em-landing__tagline">premium shopify themes</p>
      <p class="em-landing__subtagline">and custom services</p>
      <p class="em-landing__caption">100+ custom <i>Shopify</i> stores served since 2014</p>
      <div class="em-landing__actions">
        <a
          class="em-landing__button em-landing__button--primary"
          href="mailto:hello@electricmaybe.com"
          aria-label="Contact us for custom services"
          data-em-gtag='{"event":"click","params":{"event_category":"Contact","event_label":"Custom Enquiry","value":1}}'
        >reach us now</a>
        <a
          class="em-landing__button em-landing__button--secondary"
          href="https://themes.shopify.com/themes/aisle/presets/aisle"
          aria-label="View our themes on Shopify"
          data-em-gtag='{"event":"click","params":{"event_category":"CTA","event_label":"Buy Themes","value":1}}'
        >buy our themes</a>
        <a
          class="em-landing__button em-landing__button--ghost"
          href="https://electricmaybesupport.zendesk.com/"
          aria-label="Access theme support"
          data-em-gtag='{"event":"click","params":{"event_category":"Support","event_label":"Help Center","value":1}}'
        >get theme support</a>
      </div>
    </div>
    <div
      class="em-landing__snap"
      role="region"
      aria-label="Selected client work"
      tabindex="0"
    >
      <div class="em-landing__work-item">
        <video autoplay muted loop playsinline aria-hidden="true">
