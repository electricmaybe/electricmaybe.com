{% comment %}
  @file sections/s--electric-maybe-landing.liquid
  @summary Electric Maybe agency homepage. Logo and carousel media come from section settings and blocks (Content > Files / library). Video OR image per slide; video wins if both are set.
{% endcomment %}

{{ 'em-landing.css' | asset_url | stylesheet_tag }}

<div class="em-landing">
  <div class="em-landing__container">
    <div class="em-landing__title-wrap">
      {%- assign logo_alt = section.settings.logo_alt | strip -%}
      {%- if logo_alt == blank -%}
        {%- assign logo_alt = 'Electric Maybe' -%}
      {%- endif -%}
      {%- if section.settings.logo != blank -%}
        <span class="em-landing__logo-wrap">
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag: alt: logo_alt, class: 'em-landing__logo', loading: 'eager', fetchpriority: 'high'
          }}
        </span>
      {%- else -%}
        <span class="em-landing__logo em-landing__logo--text" role="img" aria-label="{{ logo_alt | escape }}">Electric Maybe</span>
      {%- endif -%}
      <h1>
        <span class="em-landing__line-1">your store needs some</span>
        <span class="em-landing__line-2">electric maybe?</span>
      </h1>
      <p class="em-landing__tagline">premium shopify themes</p>
      <p class="em-landing__subtagline">and custom services</p>
      <p class="em-landing__caption">100+ custom <i>Shopify</i> stores served since 2014</p>
      <div class="em-landing__actions">
        <a
          class="em-landing__button em-landing__button--primary"
          href="mailto:hello@electricmaybe.com"
          aria-label="Contact us for custom services"
          data-em-gtag='{"event":"click","params":{"event_category":"Contact","event_label":"Custom Enquiry","value":1}}'
        >reach us now</a>
        <a
          class="em-landing__button em-landing__button--secondary"
          href="https://themes.shopify.com/themes/aisle/presets/aisle"
          aria-label="View our themes on Shopify"
          data-em-gtag='{"event":"click","params":{"event_category":"CTA","event_label":"Buy Themes","value":1}}'
        >buy our themes</a>
      </div>
    </div>
    <div
      class="em-landing__snap"
      role="region"
      aria-label="Selected client work"
      tabindex="0"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- assign slide_video = block.settings.video -%}
          {%- assign slide_image = block.settings.image -%}
          {%- if slide_video != blank or slide_image != blank -%}
            {%- assign cap = block.settings.label | strip -%}
            {%- if cap == blank -%}
              {%- assign cap = 'Client work' -%}
            {%- endif -%}
            {%- assign img_alt = block.settings.image_alt | strip -%}
            {%- if img_alt == blank -%}
              {%- assign img_alt = cap -%}
            {%- endif -%}
            <div class="em-landing__work-item" {{ block.shopify_attributes }}>
              <div class="em-landing__slide-media"{% if slide_video != blank %} aria-hidden="true"{% endif %}>
                {%- if slide_video != blank -%}
                  {{
                    slide_video
                    | video_tag:
                      class: 'em-landing__slide-el',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      image_size: '1600x'
                  }}
                {%- else -%}
                  {{
                    slide_image
                    | image_url: width: 1600
                    | image_tag:
                      alt: img_alt,
                      class: 'em-landing__slide-el',
                      loading: 'lazy',
                      sizes: '(max-width: 680px) 85vw, 640px'
                  }}
                {%- endif -%}
              </div>
              <span>{{ cap }}</span>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var a = e.target.closest('a[data-em-gtag]');
      if (!a || typeof gtag !== 'function') return;
      try {
        var payload = JSON.parse(a.getAttribute('data-em-gtag'));
        gtag('event', payload.event || 'click', payload.params || {});
      } catch (err) {}
    });
  })();
</script>

{% schema %}
{
  "name": "Electric Maybe home",
  "tag": "section",
  "class": "section-s--electric-maybe-landing",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Upload SVG or PNG in Settings > Files, then select here."
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Electric Maybe"
    },
    {
      "type": "header",
      "content": "Work carousel"
    },
    {
      "type": "paragraph",
      "content": "Add slides below. For each slide, choose a Shopify-hosted video OR an image (from Files). If both are set, the video is shown."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Caption",
          "default": "Client"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload MP4 etc. to Content > Files, then pick the file here."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used when no video is selected."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Accessibility; defaults to caption if empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Electric Maybe home",
      "blocks": [
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "HiSmile" } },
        { "type": "slide", "settings": { "label": "Nuuds" } },
        { "type": "slide", "settings": { "label": "Nuuds" } },
        { "type": "slide", "settings": { "label": "Nuuds" } },
        { "type": "slide", "settings": { "label": "Nuuds" } },
        { "type": "slide", "settings": { "label": "Nuuds" } },
        { "type": "slide", "settings": { "label": "Nuuds" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } },
        { "type": "slide", "settings": { "label": "Northern Wide Plank" } }
      ]
    }
  ]
}
{% endschema %}
