<header-element
  class="block text-ui-base {% comment %}[[data-threshold-passed=true]]:max-lg:-translate-y-(--promo-banner-height){% endcomment %} transition-transform duration-750 ease-in-out"
  data-sticky="true"
>

  <header class="lg:relative [[data-threshold-passed=true]_&]:lg:max-h-28 bg-surface transition-colors duration-300" id="Header">
    <div class="header__main flex min-h-15 lg:min-h-28 lg:px-s-whole items-stretch lg:gap-x-s-xl z-40 relative">
      <drawer-trigger
        data-target="menu-drawer"
        class="px-b-xs py-b-xs transition-colors lg:hidden content-center"
      >
        {%- render 'a--icon', icon: 'menu', width: '1.5rem', height: '1.5rem', animate: true, aria_hidden: true -%}
      </drawer-trigger>
      {% capture logo_black %}
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="w-30 lg:w-35"
          width="280"
          height="68"
          loading="eager"
        >
      {% endcapture %}
      {{
        logo_black
        | link_to: routes.root_url,
          class: 'logo-black shrink-0 place-self-center',
          aria-label: shop.name
      }}
      {% capture logo_white %}
        <img
          src="{{ 'logo-white.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="w-30 lg:w-35"
          width="280"
          height="68"
          loading="eager"
        >
      {% endcapture %}
      {{
        logo_white
        | link_to: routes.root_url,
          class: 'logo-white shrink-0 place-self-center hidden',
          aria-label: shop.name
      }}
      {%- render 'header--main-navigation' %}
      <div class="flex items-center justify-end lg:gap-x-b-base max-lg:ml-auto max-lg:w-auto max-lg:gap-x-b-xs shrink-0">
        {%- liquid
          render 'header--predictive-search'
          render 'm--account-selector', align: 'bottom-right', identifier: 'Header', account_title_class: 'max-lg:hidden'
          capture cart_icon
            render 'a--icon', icon: 'bag', width: '1.5rem', height: '1.5rem'
            render 'header--cart-bubble'
          endcapture
          assign cart_aria_label = 'templates.cart.cart' | t


          # Cart icon behavior:
          # - On /cart: go to cart page (reloads current page)
          # - Elsewhere: open cart drawer
          if request.page_type == 'cart'
            echo cart_icon | link_to: routes.cart_url, class: 'header-action max-lg:text-primary px-b-xs py-b-xs lg:bg-subtle hover:bg-emphasis lg:rounded-full max-lg:h-full transition-colors content-center relative flex items-center shrink-0', aria_label: cart_aria_label
          else
            echo '<drawer-trigger data-target="cart-drawer" class="header-action max-lg:text-primary px-b-xs py-b-xs lg:bg-subtle hover:bg-emphasis lg:rounded-full max-lg:h-full transition-colors content-center relative flex items-center shrink-0" aria-label="' | append: cart_aria_label | append: '">'
            echo cart_icon
            echo '</drawer-trigger>'
          endif
        -%}
      </div>
    </div>
  </header>
</header-element>
{%- render 'header--menu-drawer' -%}

<script>
  (() => {
    if (document.documentElement.dataset.headerNavOpenInit === 'true') return;
    document.documentElement.dataset.headerNavOpenInit = 'true';

    const headerEl = document.querySelector('header-element');
    if (!headerEl) return;

    const nav = headerEl.querySelector('.header__desktop-navigation');
    const controller = new AbortController();

    const menuDrawer = document.getElementById('menu-drawer');

    const setOpen = (isOpen) => {
      if (isOpen) headerEl.setAttribute('data-nav-open', 'true');
      else headerEl.removeAttribute('data-nav-open');
    };

    const setMenuOpen = (isOpen) => {
      if (isOpen) headerEl.setAttribute('data-menu-open', 'true');
      else headerEl.removeAttribute('data-menu-open');
    };

    if (nav) {
      nav.addEventListener('mouseenter', () => setOpen(true), { signal: controller.signal });
      nav.addEventListener('mouseleave', () => setOpen(false), { signal: controller.signal });
      nav.addEventListener('focusin', () => setOpen(true), { signal: controller.signal });
      nav.addEventListener(
        'focusout',
        (e) => {
          if (!nav.contains(e.relatedTarget)) setOpen(false);
        },
        { signal: controller.signal }
      );
    }

    if (menuDrawer) {
      menuDrawer.addEventListener('drawer:opening', () => setMenuOpen(true), { signal: controller.signal });
      menuDrawer.addEventListener('drawer:closing', () => setMenuOpen(false), { signal: controller.signal });
    }

    window.addEventListener(
      'pagehide',
      () => {
        try {
          controller.abort();
        } catch (e) {}
      },
      { signal: controller.signal }
    );
  })();
</script>

