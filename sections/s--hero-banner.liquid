{%- capture overlay_cards -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'card' -%}
      {%- continue -%}
    {%- endif -%}
    {%- liquid
      assign card_is_clickable = false
      assign card_tag = 'div'
      assign card_aria_label = block.settings.heading | strip_html | strip | default: block.settings.button_label | strip

      if block.settings.button_label != blank and block.settings.button_url != blank
        assign card_is_clickable = true
        assign card_tag = 'a'
      endif
    -%}
    <{{ card_tag }}
      class="flex-1{% if card_is_clickable %} group cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent{% endif %}"
      {% if card_is_clickable %}
        href="{{ block.settings.button_url }}"
        aria-label="{{ card_aria_label | escape }}"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      <div class="flex flex-col lg:flex-row gap-b-base h-56 overflow-hidden {% if s.content_type == 'car-model' %}px-0{% else %}px-s-inner lg:px-s-whole{% endif %} relative">
        <div class="flex flex-1 flex-col justify-end {% if s.content_type == 'car-model' %}py-b-base{% else %}py-b-xl{% endif %} relative z-10">
          <div class="flex flex-col gap-y-b-base">
            <div class="flex flex-col gap-y-b-xxs">
              {%- if block.settings.heading != blank -%}
                <h3 class="h4 text-on-accent flex items-center gap-x-b-sm">
                  {{- block.settings.heading -}}
                  <span class="w-6 h-6 md:w-6 md:h-6 lg:w-8 lg:h-8 shrink-0">
                    {%- render 'a--icon', icon: 'arrow-r-up', width: 32, class: 'w-full h-full text-on-accent' -%}
                  </span>
                </h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="text-ui-small text-on-accent/80">
                  {{- block.settings.description -}}
                </p>
              {%- endif -%}
            </div>
            {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
              <span
                class="{% render 'a--button-classes', style: 'primary', size: 'base', content: 'text-only' %} pointer-events-none"
                aria-hidden="true"
              >
                {{- block.settings.button_label -}}
              </span>
            {%- endif -%}
          </div>
        </div>
        {%- if block.settings.image != blank -%}
          <div class="relative flex-1">
            {%- render 'a--image-responsive',
              image: block.settings.image,
              picture_class: 'w-full h-full',
              image_class: 'w-full h-full object-contain',
              object_fit: 'object-contain',
              crop: 'right'
            -%}
          </div>
        {%- endif -%}
      </div>
    </{{ card_tag }}>
  {%- endfor -%}
{%- endcapture -%}

{%- if overlay_header_active -%}
  <style>
    /* Homepage hero: header overlays the hero, so header-group should not reserve layout height */
    .shopify-section-group-header-group {
      height: 0;
      background: transparent;
    }

    /*
      Overlay header variant:
      - At top of page: header has no background
      - After scroll threshold: header returns to normal background
    */
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header {
      background-color: transparent !important;
    }
    header-element[data-threshold-passed="true"] #Header,
    header-element.menu-open #Header,
    header-element[data-nav-open="true"] #Header,
    header-element[data-menu-open="true"] #Header,
    header-element:hover #Header,
    header-element:focus-within #Header {
      background-color: var(--color-dune-50) !important;
    }

    /* Contrast header (only at top) */
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header__main {
      color: var(--color-dune-50);
    }
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header__desktop-navigation,
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header__desktop-navigation a,
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header-action {
      color: var(--color-dune-50) !important;
    }

    /* Logo swap (only at top) */
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .logo-black {
      display: none !important;
    }
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .logo-white {
      display: inline-flex !important;
    }
    header-element[data-threshold-passed="true"] #Header .logo-black,
    header-element.menu-open #Header .logo-black,
    header-element[data-nav-open="true"] #Header .logo-black,
    header-element[data-menu-open="true"] #Header .logo-black,
    header-element:hover #Header .logo-black,
    header-element:focus-within #Header .logo-black {
      display: inline-flex !important;
    }
    header-element[data-threshold-passed="true"] #Header .logo-white,
    header-element.menu-open #Header .logo-white,
    header-element[data-nav-open="true"] #Header .logo-white,
    header-element[data-menu-open="true"] #Header .logo-white,
    header-element:hover #Header .logo-white,
    header-element:focus-within #Header .logo-white {
      display: none !important;
    }

    /* Keep dropdown menus readable */
    header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header__desktop-navigation [class*="bg-surface"] {
      color: var(--text-color-primary);
    }

    /* Contrast action buttons (search/cart) on desktop */
    @media (min-width: 1024px) {
      header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header-action {
        background-color: var(--color-dune-900) !important;
      }
      header-element:not([data-threshold-passed="true"]):not(.menu-open):not([data-nav-open="true"]):not([data-menu-open="true"]):not(:hover):not(:focus-within) #Header .header-action:hover {
        opacity: 0.8;
      }
    }

    /* Invert logo for contrast mode (best-effort) 
    header-element:not([data-threshold-passed="true"]) #Header img {
      filter: invert(1) brightness(2);
    }*/
  </style>
{%- endif -%}

