        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% javascript %}
  const brandModelWrappers = document.querySelectorAll('[data-brand-model]');

  brandModelWrappers.forEach((wrapper) => {
    const brandSelect = wrapper.querySelector('[data-brand-select]');
    const modelSelect = wrapper.querySelector('[data-model-select]');
    const searchButton = wrapper.querySelector('[data-search-button]');
    if (!brandSelect || !modelSelect) return;

    let pairs = [];
    try {
      pairs = JSON.parse(wrapper.dataset.brandModelPairs || '[]');
    } catch (error) {
      pairs = [];
    }

    const modelMap = pairs.reduce((acc, pair) => {
      if (!pair || !pair.brand || !pair.model || !pair.url) return acc;
      if (!acc[pair.brand]) acc[pair.brand] = [];
      acc[pair.brand].push({ label: pair.model, url: pair.url });
      return acc;
    }, {});

    const placeholder = modelSelect.dataset.placeholder || '';

    const resetModels = () => {
      modelSelect.innerHTML = '';
      const option = document.createElement('option');
      option.value = '';
      option.textContent = placeholder;
      option.disabled = true;
      option.selected = true;
      modelSelect.appendChild(option);
      modelSelect.disabled = true;
      modelSelect.classList.add('text-primary/30');
      if (searchButton) {
        searchButton.disabled = true;
      }
    };

    const populateModels = (brand) => {
      resetModels();
      if (!brand || !modelMap[brand]) return;
      modelMap[brand].forEach((model) => {
        const option = document.createElement('option');
        option.value = model.label;
        option.textContent = model.label;
        option.dataset.url = model.url;
        modelSelect.appendChild(option);
      });
      modelSelect.disabled = false;
      modelSelect.classList.remove('text-primary/30');
    };

    resetModels();
    brandSelect.addEventListener('change', (event) => {
      populateModels(event.target.value);
    });
    modelSelect.addEventListener('change', (event) => {
      const selectedOption = event.target.selectedOptions[0];
      const targetUrl = selectedOption?.dataset?.url;
      if (!searchButton) return;
      if (targetUrl) {
        searchButton.disabled = false;
        searchButton.dataset.targetUrl = targetUrl;
      } else {
        searchButton.disabled = true;
      }
    });
    if (searchButton) {
      searchButton.addEventListener('click', () => {
        const targetUrl = searchButton.dataset.targetUrl;
        if (targetUrl) window.location.href = targetUrl;
      });
    }
  });
{% endjavascript %}

