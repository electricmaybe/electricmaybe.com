<section
  class="relative w-full overflow-visible lg:overflow-hidden block-visibility"
  {{ section.shopify_attributes }}
>
  <div class="relative w-full {{ media_height_class }} z-1">
    {%- if media_all_auto_height -%}
      <div aria-hidden="true">
        {%- render 'a--image-responsive',
          image_mobile: s.image_mobile,
          image_tablet: s.image_tablet,
          image_desktop: s.image_desktop,
          picture_class: 'w-full',
          image_class: 'w-full object-cover',
          object_fit: 'object-cover',
          crop: 'center',
          fetchpriority: 'high'
        -%}
      </div>
    {%- else -%}
      <div class="absolute inset-0" aria-hidden="true">
        {%- render 'a--image-responsive',
          image_mobile: s.image_mobile,
          image_tablet: s.image_tablet,
          image_desktop: s.image_desktop,
          picture_class: 'absolute inset-0 w-full h-full',
          image_class: 'w-full h-full object-cover',
          object_fit: 'object-cover',
          crop: 'center',
          fetchpriority: 'high'
        -%}
      </div>
    {%- endif -%}

    {%- if overlay_opacity > 0 -%}
      <div
        class="absolute inset-0 pointer-events-none"
        style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity }};"
        aria-hidden="true"
      ></div>
    {%- endif -%}

    {%- if overlay_blur > 0 -%}
      <div
        class="absolute inset-0 pointer-events-none"
        style="backdrop-filter: blur({{ overlay_blur }}px); -webkit-backdrop-filter: blur({{ overlay_blur }}px);"
        aria-hidden="true"
      ></div>
    {%- endif -%}

    <div
      class="absolute inset-0 flex flex-col pb-0{% if overlay_header_active %} pt-15 lg:pt-28{% endif %}"
    >
      {%- if content != blank -%}
        <div class="flex flex-1 w-full h-full {{ position_mobile }} {{ position_tablet }} {{ position_desktop }}">
          <div class="px-s-outer py-s-xs w-full">
            <div class="px-s-inner flex flex-col gap-y-s-xs w-full">
              {{- content -}}
            </div>
          </div>
        </div>
      {%- endif -%}
      {%- if mini_cards_top != blank -%}
        <div class="mini-cards mini-cards--on-banner w-full text-on-accent items-center self-stretch mt-auto px-s-outer pb-0{% if s.content_type == 'partner' %} hidden lg:flex{% endif %}">
          <div class="px-s-inner py-s-xs {% if s.content_type == 'free-return' %}grid grid-cols-3 gap-x-s-sm{% else %}flex gap-x-s-xl gap-y-b-sm items-center flex-wrap justify-center lg:flex-nowrap{% endif %}">
            {{- mini_cards_top -}}
          </div>
        </div>
      {%- endif -%}
      {%- if s.content_type == 'contact' and contact_info_banner != blank -%}
        <div class="contact-info contact-info--on-banner hidden lg:flex w-full text-on-accent items-center self-stretch mt-auto px-s-outer pb-0">
          <div class="px-s-inner py-s-xs w-full">
            {{- contact_info_banner -}}
          </div>
        </div>
      {%- endif -%}
        {%- if show_overlay_cards and overlay_cards != blank -%}
          <div class="hero-banner__overlay-cards hidden lg:flex w-full mt-auto px-s-outer pb-s-xs">
            <div class="px-s-inner w-full">
              <div class="flex gap-b-base {% if s.content_type == 'car-model' %}gap-x-b-base{% else %}{% endif %}">
                {{- overlay_cards -}}
              </div>
          </div>
        </div>
      {%- endif -%}
  </div>
  </div>

  {%- if s.content_type == 'contact' and contact_info_below != blank -%}
    <div class="contact-info contact-info--below w-full px-s-outer lg:hidden">
      <div class="px-s-inner py-s-xs">
        {{- contact_info_below -}}
      </div>
    </div>
  {%- endif -%}
  {%- if s.content_type == 'partner' and mini_cards_top != blank -%}
    <div class="mini-cards mini-cards--below w-full px-s-outer lg:hidden">
      <div class="px-s-inner w-full text-primary py-b-base">
        <div class="flex w-full gap-x-s-sm items-center overflow-x-auto hide-scroll-bar flex-nowrap justify-between md:grid md:grid-cols-7 md:gap-x-s-base md:overflow-visible">
          {{- mini_cards_top -}}
        </div>
      </div>
    </div>
  {%- endif -%}
  {%- if numbered_cards != blank -%}
    <div class="numbered-cards w-full px-s-outer bg-emphasis">
      <div class="flex flex-col md:flex-row w-full">
        {{- numbered_cards -}}
      </div>
    </div>
  {%- endif -%}
  {%- if mini_cards_below != blank -%}
