{%- liquid
  assign s = section.settings
  assign overlay_header_active = false
  if s.overlay_header and section.index == 1
    assign overlay_header_active = true
  endif

  assign height_class = s.height | default: 'h-128'
  assign height_md_class = s.height_md | default: 'md:h-128'
  assign height_lg_class = s.height_lg | default: 'lg:h-[32vw]'
  assign media_height_class = height_class | append: ' ' | append: height_md_class | append: ' ' | append: height_lg_class
  assign media_all_auto_height = false
  if height_class == 'h-auto' and height_md_class == 'md:h-auto' and height_lg_class == 'lg:h-auto'
    assign media_all_auto_height = true
  endif

  assign position_mobile = s.position_mobile | default: 'items-center justify-center text-center'
  assign position_tablet = s.position_tablet | default: 'md:items-center md:justify-center md:text-center'
  assign position_desktop = s.position_desktop | default: 'lg:items-center lg:justify-start lg:text-left'

  assign free_return_align_mobile = 'items-start text-left'
  if position_mobile contains 'text-center'
    assign free_return_align_mobile = 'items-center text-center'
  elsif position_mobile contains 'text-right'
    assign free_return_align_mobile = 'items-end text-right'
  endif

  assign free_return_self_mobile = 'self-start'
  if position_mobile contains 'justify-center'
    assign free_return_self_mobile = 'self-center'
  elsif position_mobile contains 'justify-end'
    assign free_return_self_mobile = 'self-end'
  endif

  assign free_return_align_tablet = 'md:items-start md:text-left'
  if position_tablet contains 'md:text-center'
    assign free_return_align_tablet = 'md:items-center md:text-center'
  elsif position_tablet contains 'md:text-right'
    assign free_return_align_tablet = 'md:items-end md:text-right'
  endif

  assign free_return_self_tablet = 'md:self-start'
  if position_tablet contains 'md:justify-center'
    assign free_return_self_tablet = 'md:self-center'
  elsif position_tablet contains 'md:justify-end'
    assign free_return_self_tablet = 'md:self-end'
  endif

  assign free_return_align_desktop = 'lg:items-start lg:text-left'
  if position_desktop contains 'lg:text-center'
    assign free_return_align_desktop = 'lg:items-center lg:text-center'
  elsif position_desktop contains 'lg:text-right'
    assign free_return_align_desktop = 'lg:items-end lg:text-right'
  endif

  assign free_return_self_desktop = 'lg:self-start'
  if position_desktop contains 'lg:justify-center'
    assign free_return_self_desktop = 'lg:self-center'
  elsif position_desktop contains 'lg:justify-end'
    assign free_return_self_desktop = 'lg:self-end'
  endif

  assign overlay_color = s.overlay_color | default: '#000000'
  assign overlay_opacity = s.overlay_opacity | default: 30 | divided_by: 100.0
  assign overlay_blur = s.overlay_blur | default: 0

  assign show_sm = s.show_sm | default: true, allow_false: true
  assign show_md = s.show_md | default: true, allow_false: true
  assign show_lg = s.show_lg | default: true, allow_false: true

  assign show_overlay_cards = false
  if s.content_type == 'car-model'
    if s.height_lg == 'lg:h-[48vw]' or s.height_lg == 'lg:h-screen'
      assign show_overlay_cards = true
    endif
  endif


  assign desired_brands_raw = 'Abarth||Aiways||Alfa Romeo||Alpine||Audi||BMW||BYD||Bentley||Cadillac||Chery||Chevrolet||Citroën||Cupra||DS||Dacia||Dongfeng||Ferrari||Fiat||Fisker||Ford||GWM||Genesis||Honda||Hongqi||Hyundai||JAC||Jaecoo||Jaguar||Jeep||KGM||Kia||LEVC||Lancia||Land Rover||Landrover / Range Rover||Leapmotor||Lexus||Lightyear||Lotus||Lucid||Lynk&Co||MG||Maserati||Mazda||Mercedes||Mini||Mitsubishi||NIO||Nissan||Opel||Peugeot||Polestar||Porsche||Range Rover||Renault||Rolls Royce||SEAT||SSANGYONG||Seres||Skoda||Smart||Sono||SsangYong||Subaru||Suzuki||Tesla||Toyota||Vauxhall||VinFast||Volkswagen||Volvo||Voyah||XPENG||Zeekr'
  assign desired_brands = desired_brands_raw | split: '||'
  assign store_brand_hits_raw = ''
  assign brand_model_pairs_raw = ''
  for collection in collections
    assign title_downcase = collection.title | downcase
    for desired_brand in desired_brands
      assign desired_brand_downcase = desired_brand | downcase
      if title_downcase contains desired_brand_downcase
        if store_brand_hits_raw == ''
          assign store_brand_hits_raw = desired_brand
        else
          assign store_brand_hits_raw = store_brand_hits_raw | append: '||' | append: desired_brand
        endif

        assign model_clean = collection.title
        assign model_clean = model_clean | replace: 'Charging cable', '' | replace: 'Charging Cable', '' | strip
        assign model_clean = model_clean | replace: 'Charging table', '' | replace: 'charging cable', '' | strip
        assign model_clean = model_clean | replace: desired_brand, '' | strip
        assign model_clean = model_clean | replace: '  ', ' ' | replace: '  ', ' ' | strip
        assign model_clean = model_clean | replace_first: '-', '' | replace_first: '–', '' | strip
        if model_clean != blank
          if brand_model_pairs_raw == ''
            assign brand_model_pairs_raw = desired_brand | append: '||' | append: model_clean | append: '||' | append: collection.url
          else
            assign brand_model_pairs_raw = brand_model_pairs_raw | append: '|||' | append: desired_brand | append: '||' | append: model_clean | append: '||' | append: collection.url
          endif
        endif
      endif
    endfor
  endfor
  assign filtered_brand_list = store_brand_hits_raw | split: '||' | uniq | sort
  assign brand_model_pairs = brand_model_pairs_raw | split: '|||'

-%}

{%- capture mini_cards_top -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'mini_card' -%}
      {%- continue -%}
    {%- endif -%}
    {%- if s.content_type == 'free-return' and forloop.index > 3 -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign mini_text = block.settings.text -%}
    {%- assign mini_icon_image = block.settings.icon_image -%}
    {%- assign mini_icon = block.settings.icon -%}
    {%- assign mini_icon_viewbox = '0 0 32 32' -%}
    {%- case mini_icon -%}
      {%- when 'delivery' -%}
        {%- assign mini_icon_viewbox = '0 0 25 27' -%}
      {%- when 'secure_2' -%}
        {%- assign mini_icon_viewbox = '0 0 22 24' -%}
      {%- when 'shipping' -%}
        {%- assign mini_icon_viewbox = '0 0 31 19' -%}
      {%- when 'newproduct' -%}
        {%- assign mini_icon_viewbox = '0 0 32 32' -%}
      {%- when 'discount' -%}
        {%- assign mini_icon_viewbox = '0 0 31 32' -%}
      {%- when 'review' -%}
        {%- assign mini_icon_viewbox = '0 0 32 32' -%}
      {%- when 'europe' -%}
        {%- assign mini_icon_viewbox = '0 0 32 32' -%}
    {%- endcase -%}
    <div class="mini-card shrink-0 flex flex-col items-center text-center gap-y-b-xxs lg:flex-row lg:text-left lg:gap-x-b-base w-auto{% if s.content_type == 'free-return' %} w-full min-w-0 px-b-xxs lg:justify-center{% elsif s.content_type == 'partner' %} lg:flex-col!{% endif %}" {{ block.shopify_attributes }}>
      {%- if mini_icon != blank -%}
        {%- render 'a--icon', icon: mini_icon, class: 'mini-card-icon w-6 h-6 text-current', viewBox: mini_icon_viewbox -%}
      {%- elsif mini_icon_image != blank -%}
        <img
          src="{{ mini_icon_image | image_url: width: 48 }}"
          width="24"
          height="24"
          alt="{{ mini_text | strip_html | escape }}"
          class="mini-card-icon w-6 h-6 object-contain"
          loading="lazy"
        >
      {%- endif -%}
      {%- if mini_text != blank -%}
        <div class="text-ui-base leading-[1.2] [&>p]:m-0 [&>h1]:m-0 [&>h2]:m-0 [&>h3]:m-0 [&>h4]:m-0 [&>h5]:m-0 [&>h6]:m-0{% if s.content_type == 'free-return' %} whitespace-normal text-center wrap-break-word{% endif %}">{{ mini_text }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- capture mini_cards_below -%}
  {%- for block in section.blocks -%}
    {%- if s.content_type != 'free-return' -%}
      {%- continue -%}
    {%- endif -%}
    {%- if block.type != 'mini_card' -%}
      {%- continue -%}
    {%- endif -%}
    {%- if forloop.index <= 3 -%}
      {%- continue -%}
    {%- endif -%}
    {%- assign mini_text = block.settings.text -%}
    {%- assign mini_icon_image = block.settings.icon_image -%}
    {%- assign mini_icon = block.settings.icon -%}
    {%- assign mini_icon_viewbox = '0 0 32 32' -%}
    {%- case mini_icon -%}
      {%- when 'delivery' -%}
        {%- assign mini_icon_viewbox = '0 0 25 27' -%}
      {%- when 'secure_2' -%}
        {%- assign mini_icon_viewbox = '0 0 22 24' -%}
      {%- when 'shipping' -%}
        {%- assign mini_icon_viewbox = '0 0 31 19' -%}
      {%- when 'newproduct' -%}
        {%- assign mini_icon_viewbox = '0 0 32 32' -%}
      {%- when 'discount' -%}
        {%- assign mini_icon_viewbox = '0 0 31 32' -%}
      {%- when 'review' -%}
        {%- assign mini_icon_viewbox = '0 0 32 32' -%}
      {%- when 'europe' -%}
        {%- assign mini_icon_viewbox = '0 0 32 32' -%}
    {%- endcase -%}
    <div class="mini-card shrink-0 flex flex-col items-center text-center gap-y-b-sm w-auto md:w-full" {{ block.shopify_attributes }}>
      {%- if mini_icon != blank -%}
        {%- render 'a--icon', icon: mini_icon, class: 'mini-card-icon w-6 h-6 text-current', viewBox: mini_icon_viewbox -%}
      {%- elsif mini_icon_image != blank -%}
        <img
          src="{{ mini_icon_image | image_url: width: 48 }}"
          width="24"
          height="24"
          alt="{{ mini_text | strip_html | escape }}"
          class="mini-card-icon w-6 h-6 object-contain"
          loading="lazy"
        >
      {%- endif -%}
      {%- if mini_text != blank -%}
        <div class="text-ui-base leading-[1.2] [&>p]:m-0 [&>h1]:m-0 [&>h2]:m-0 [&>h3]:m-0 [&>h4]:m-0 [&>h5]:m-0 [&>h6]:m-0">{{ mini_text }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- capture contact_info_banner -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'contact_info' -%}
      {%- continue -%}
    {%- endif -%}
    <div class="flex flex-col gap-y-s-sm w-full text-left" {{ block.shopify_attributes }}>
      {%- if block.settings.contact_info_title != blank -%}
        <p class="h3 text-on-accent">
          {{ block.settings.contact_info_title | escape }}
        </p>
      {%- endif -%}
      <div class="flex w-full items-center gap-x-s-base">
        {%- if block.settings.contact_info_primary != blank -%}
          <div class="flex-1 lg:flex-none lg:basis-1/3 text-ui-base leading-[1.2] text-on-accent [&_p]:m-0">
            {{ block.settings.contact_info_primary }}
          </div>
        {%- endif -%}
        <span class="w-px self-stretch bg-subtle"></span>
        {%- if block.settings.contact_info_secondary != blank -%}
          <div class="flex-1 text-ui-base leading-[1.2] text-on-accent [&_p]:m-0">
            {{ block.settings.contact_info_secondary }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- capture contact_info_below -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'contact_info' -%}
      {%- continue -%}
    {%- endif -%}
    <div class="flex flex-col gap-y-s-xs w-full text-left" {{ block.shopify_attributes }}>
      {%- if block.settings.contact_info_title != blank -%}
        <p class="h3 text-primary">
          {{ block.settings.contact_info_title | escape }}
        </p>
      {%- endif -%}
      {%- if block.settings.contact_info_primary != blank -%}
        <div class="text-ui-base leading-[1.2] text-primary [&_p]:m-0">
          {{ block.settings.contact_info_primary }}
        </div>
      {%- endif -%}
      <span class="h-px w-full border-b border-secondary"></span>
      {%- if block.settings.contact_info_secondary != blank -%}
        <div class="text-ui-base leading-[1.2] text-primary [&_p]:m-0">
          {{ block.settings.contact_info_secondary }}
        </div>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- capture numbered_cards -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'numbered_card' -%}
      {%- continue -%}
    {%- endif -%}
    <div class="flex-1 border-secondary{% if forloop.first %} border-b md:border-b-0 md:border-r{% endif %}" {{ block.shopify_attributes }}>
      <div class="px-s-inner py-s-xs lg:py-b-xxl h-full">
        <div class="flex flex-col gap-y-s-xs lg:flex-row items-center lg:gap-x-s-xl h-full">
          {%- if block.settings.image != blank -%}
            <div class="order-first lg:order-last shrink-0">
              <img
                src="{{ block.settings.image | image_url: width: 320 }}"
                width="144"
                height="144"
                alt="{{ block.settings.title | escape }}"
                class="w-24 h-24 lg:w-36 lg:h-36 object-contain"
                loading="lazy"
              >
            </div>
          {%- endif -%}
          <div class="flex flex-col gap-y-s-xs text-primary">
            {%- if block.settings.title != blank -%}
              <p class="h2">
                {{ block.settings.title | escape }}
              </p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <div class="rte text-body">
                {{ block.settings.description }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- capture content -%}
  {%- if s.content_type == 'main_banner_content' -%}
    {%- render 'm--hero-banner-content',
      sub_heading: s.sub_heading,
      heading: s.heading,
      body: s.body,
      search_placeholder: s.search_placeholder,
      search_aria_label: s.search_aria_label
    -%}
  {%- elsif s.content_type == 'partner' -%}
    <div class="partner-content flex flex-col gap-y-s-xs w-full lg:w-auto max-w-[448px]">
      {%- if s.partner_title != blank -%}
        <div class="h1 text-on-accent [&>p]:m-0 [&>h1]:m-0 [&>h2]:m-0 [&>h3]:m-0 [&>h4]:m-0 [&>h5]:m-0 [&>h6]:m-0">
          {{ s.partner_title }}
        </div>
      {%- endif -%}
      {%- if s.partner_description != blank -%}
        <div class="text-body-lg text-on-accent">
          {{ s.partner_description }}
        </div>
      {%- endif -%}
      {%- if s.partner_button_1_label != blank or s.partner_button_2_label != blank -%}
        <div class="partner-actions flex flex-wrap w-full gap-x-b-lg gap-y-b-sm">
          {%- if s.partner_button_1_label != blank and s.partner_button_1_url != blank -%}
            {%- render 'a--button',
              tag: 'a',
              style: 'secondary',
              label: s.partner_button_1_label,
              url: s.partner_button_1_url,
              class: 'bg-transparent border border-on-accent text-on-accent'
            -%}
          {%- endif -%}
          {%- if s.partner_button_2_label != blank and s.partner_button_2_url != blank -%}
            {%- render 'a--button',
              tag: 'a',
              style: 'primary',
              label: s.partner_button_2_label,
              url: s.partner_button_2_url,
              class: '!bg-white !text-primary !border-0'
            -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- elsif s.content_type == 'free-return' -%}
    <div class="free-return-content flex flex-col gap-y-s-xs w-full lg:w-auto max-w-md {{ free_return_align_mobile }} {{ free_return_align_tablet }} {{ free_return_align_desktop }} {{ free_return_self_mobile }} {{ free_return_self_tablet }} {{ free_return_self_desktop }}">
      {%- if s.partner_title != blank -%}
        <div class="h1 text-on-accent [&>p]:m-0 [&>h1]:m-0 [&>h2]:m-0 [&>h3]:m-0 [&>h4]:m-0 [&>h5]:m-0 [&>h6]:m-0">
          {{ s.partner_title }}
        </div>
      {%- endif -%}
      {%- if s.partner_description != blank -%}
        <div class="text-body-lg text-on-accent">
          {{ s.partner_description }}
        </div>
      {%- endif -%}
      {%- if s.free_return_info != blank -%}
        <div class="flex items-center gap-x-b-sm bg-white/15 backdrop-blur-[2px] px-b-sm py-b-xs">
          {%- render 'a--icon', icon: 'info-line', class: 'w-6 h-6 text-on-accent shrink-0' -%}
          <p class="text-ui-small text-on-accent">
            {{ s.free_return_info | escape }}
          </p>
        </div>
      {%- endif -%}
      {%- if s.partner_button_1_label != blank and s.partner_button_1_url != blank -%}
        {%- render 'a--button',
          style: 'primary',
          label: s.partner_button_1_label,
          url: s.partner_button_1_url,
          class: '!bg-white !text-primary !border-0'
        -%}
      {%- endif -%}
    </div>
  {%- elsif s.content_type == 'contact' -%}
    <div class="contact-content flex flex-col gap-y-s-xs w-full">
      {%- if s.contact_title != blank -%}
        <h1 class="h1 text-on-accent max-w-[448px]">
          {{ s.contact_title | escape | newline_to_br }}
        </h1>
      {%- endif -%}
      {%- if s.contact_description != blank -%}
        <div class="text-body-lg text-on-accent max-w-[448px]">
          {{ s.contact_description }}
        </div>
      {%- endif -%}
    </div>
  {%- elsif s.content_type == 'brand-model' -%}
    {%- capture brand_model_pairs_json -%}
      [
        {%- for pair in brand_model_pairs -%}
          {%- assign pair_parts = pair | split: '||' -%}
          {%- assign pair_brand = pair_parts[0] -%}
          {%- assign pair_model = pair_parts[1] -%}
          {%- assign pair_url = pair_parts[2] -%}
          {%- if pair_brand != blank and pair_model != blank and pair_url != blank -%}
            {%- if forloop.index0 > 0 -%},{%- endif -%}
            {"brand":{{ pair_brand | json }},"model":{{ pair_model | json }},"url":{{ pair_url | json }}}
          {%- endif -%}
        {%- endfor -%}
      ]
    {%- endcapture -%}
    <div class="flex flex-col gap-y-s-xs items-center text-center w-full">
      {%- if s.heading != blank -%}
        <h2 class="h1 text-on-accent max-w-[448px]">
          {{ s.heading | escape | newline_to_br }}
        </h2>
      {%- endif -%}
      {%- if s.body != blank -%}
        <p class="text-body-lg text-on-accent max-w-[448px]">
          {{ s.body }}
        </p>
      {%- endif -%}
      <div
        class="flex flex-col gap-y-b-sm w-full max-w-[480px]"
        data-brand-model
        data-brand-model-pairs="{{ brand_model_pairs_json | strip | escape }}"
      >
        <div class="flex flex-row gap-x-b-lg w-full">
          <label class="relative flex-1">
            <span class="sr-only">{{ s.brand_label | escape }}</span>
            <select
              class="w-full h-16 rounded-full bg-white text-primary text-ui-base px-b-lg pr-14 appearance-none cursor-pointer"
              data-brand-select
            >
              <option value="" selected disabled>{{ s.brand_label | escape }}</option>
              {%- for brand in filtered_brand_list -%}
                <option value="{{ brand | escape }}">{{ brand | escape }}</option>
              {%- endfor -%}
            </select>
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 flex items-center justify-center w-6 h-6 overflow-hidden z-10">
              {%- render 'a--icon', icon: 'chevron-d', width: '1.5rem', height: '1.5rem' -%}
            </span>
          </label>
          <label class="relative flex-1">
            <span class="sr-only">{{ s.model_label | escape }}</span>
            <select
              class="w-full h-16 rounded-full bg-white text-primary text-ui-base px-b-lg pr-14 appearance-none cursor-pointer"
              data-model-select
              data-placeholder="{{ s.model_label | escape }}"
              disabled
            >
              <option value="" selected disabled>{{ s.model_label | escape }}</option>
            </select>
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 flex items-center justify-center w-6 h-6 overflow-hidden z-10">
              {%- render 'a--icon', icon: 'chevron-d', width: '1.5rem', height: '1.5rem' -%}
            </span>
          </label>
        </div>
        <button
          type="button"
          class="w-full h-16 rounded-full bg-[#282220] text-on-accent text-lg uppercase tracking-[0.02em] cursor-pointer"
          data-search-button
          disabled
        >
          {{ s.search_button_label | escape }}
        </button>
      </div>
    </div>
  {%- elsif s.content_type == 'car-model' -%}
    <div class="car-model-content flex flex-col gap-y-s-xs">
      {%- if s.sub_heading != blank -%}
        <p class="text-caption uppercase text-on-accent">
          {{- s.sub_heading -}}
        </p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="h1 text-on-accent max-w-[448px]">
          {{- s.heading -}}
        </h1>
      {%- endif -%}
      {%- if s.body != blank -%}
        <div class="text-body-lg text-on-accent max-w-[448px]">
          {{- s.body -}}
        </div>
      {%- endif -%}
    </div>
  {%- elsif s.content_type == 'car-brand' -%}
    <div class="car-brand-content flex flex-col items-center text-center gap-y-s-xs">
      {%- if s.brand_logo != blank -%}
        {%- assign brand_logo_alt = s.heading | default: shop.name | escape -%}
        {{
          s.brand_logo
          | image_url: width: 256
          | image_tag: loading: 'lazy', alt: brand_logo_alt, class: 'w-32 h-32 object-contain'
        }}
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="h1 text-on-accent max-w-[448px]">
          {{- s.heading -}}
        </h1>
      {%- endif -%}
      {%- if s.body_richtext != blank -%}
        <div class="text-body-lg text-on-accent max-w-[448px]">
          {{ s.body_richtext }}
        </div>
      {%- endif -%}
      {%- comment -%} Button removed for car brand content type {%- endcomment -%}
    </div>
  {%- endif -%}
