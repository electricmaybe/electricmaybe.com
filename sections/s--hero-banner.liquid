      <div class="px-s-inner w-full text-primary py-b-base">
        <div class="flex w-full gap-x-s-sm items-center overflow-x-auto hide-scroll-bar flex-nowrap justify-between md:grid md:grid-cols-7 md:gap-x-s-base md:overflow-visible">
          {{- mini_cards_below -}}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Cards section below banner {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="w-full{% if show_overlay_cards %} lg:hidden{% endif %}">
      <div class="flex flex-col md:flex-row gap-b-base lg:gap-b-base relative">
        {%- for block in section.blocks -%}
          {%- if block.type != 'card' -%}
            {%- continue -%}
          {%- endif -%}
          <div class="flex-1" {{ block.shopify_attributes }}>
            {%- render 'm--hero-banner-card',
              heading: block.settings.heading,
              description: block.settings.description,
              button_label: block.settings.button_label,
              button_url: block.settings.button_url,
              image: block.settings.image,
