{%- if collection != blank -%}
  {%- liquid
    capture content
      render 'm--collection-grid'
    endcapture
    render 'm--wrapper', content: content
  -%}
{%- else -%}
  <section class="px-s-outer py-s-base" aria-label="{{ 'sections.collections_standard.aria_label' | t }}">
    <div class="px-s-inner">
      <h1 class="h2 mb-b-base">{{ 'sections.collections_standard.heading' | t }}</h1>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-b-base gap-y-b-base">
        {%- for card_collection in collections limit: 24 -%}
          {%- if card_collection.handle == 'all' -%}
            {%- continue -%}
          {%- endif -%}
          {% render 'm--collection-card', card_collection: card_collection %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

