        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 480,
        "step": 16,
        "default": 96,
        "unit": "px",
        "label": "t:global.mobile"
      },
      {
        "type": "range",
        "id": "margin_top_md",
        "min": 0,
        "max": 480,
        "step": 16,
        "default": 96,
        "unit": "px",
        "label": "t:global.tablet"
