{% liquid
  # M--WRAPPER: Universal section wrapper with responsive positioning
  # Supports mobile (sm), tablet (md), and desktop (lg) breakpoints
  # 
  # Available parameters:
  # - content_alignment: Mobile text alignment (items-start, items-center, items-end)
  # - content_alignment_md: Tablet text alignment  
  # - content_alignment_lg: Desktop text alignment
  # - content_vertical_position_md: Tablet vertical positioning
  # - content_vertical_position_lg: Desktop vertical positioning
  # - horizontal: Enable horizontal layout
  # - horizontal_mobile: Enable horizontal layout on mobile
  # - compact: Compact mode with reduced padding
  # - overlay_vertical_position: Overlay positioning for media backgrounds

  assign s = section.settings
  if block
    assign s = block.settings
  endif

  if header_group
    assign section_style = 'color_scheme'
    assign section_width = 'bg-full'
  endif
  if compact
    assign content_alignment = 'items-start'
    assign content_vertical_position_lg = 'lg:items-center'
    assign override_vertical_padding = true
    assign vertical_padding = 4
    assign vertical_padding_md = 4
    assign vertical_padding_lg = 4
    assign override_margin_top = true
    assign margin_top = 0
    assign margin_top_md = 0
    assign margin_top_lg = 0
    assign class_inner_wrapper = class_inner_wrapper | append: ' py-vertical-padding'
  endif

  # Content alignment settings for all breakpoints
  assign content_alignment = content_alignment | default: s.content_alignment
  assign content_alignment_md = content_alignment_md | default: s.content_alignment_md
  assign content_alignment_lg = content_alignment_lg | default: s.content_alignment_lg
  
  # Vertical positioning for tablet and desktop
  assign content_vertical_position_md = content_vertical_position_md | default: s.content_vertical_position_md
  assign content_vertical_position_lg = content_vertical_position_lg | default: s.content_vertical_position_lg
  
  # Horizontal positioning for tablet and desktop
  assign content_horizontal_position_md = content_horizontal_position_md | default: s.content_horizontal_position_md
  assign content_horizontal_position_lg = content_horizontal_position_lg | default: s.content_horizontal_position_lg
  
  # Section configuration
  assign section_style = 'none'
  assign section_width = 'section-full'
  assign override_vertical_padding = override_vertical_padding | default: s.override_vertical_padding, allow_false: true
  assign vertical_padding = vertical_padding | default: s.vertical_padding
  assign vertical_padding_md = vertical_padding_md | default: s.vertical_padding_md
  assign vertical_padding_lg = vertical_padding_lg | default: s.vertical_padding_lg
  assign override_margin_top = override_margin_top | default: s.override_margin_top, allow_false: true
  assign margin_top = margin_top | default: s.margin_top
  assign margin_top_md = margin_top_md | default: s.margin_top_md
  assign margin_top_lg = margin_top_lg | default: s.margin_top_lg
  assign overlay_vertical_position = overlay_vertical_position | default: s.overlay_vertical_position

  assign class_inner_wrapper = class_inner_wrapper | append: ' flex'
  if content_vertical_position_md
    assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_vertical_position_md
  endif
  if content_vertical_position_lg
    assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_vertical_position_lg
  endif

  if url != blank
    assign class_inner_wrapper = class_inner_wrapper | append: ' relative'
  endif

  if overlay_vertical_position contains 'overlay'
    assign class_inner_wrapper = class_inner_wrapper | append: ' relative'
    if section_width == 'limited'
      assign class_inner_wrapper = class_inner_wrapper | append: ' lg:rounded-sm overflow-hidden'
    endif
  endif
  unless horizontal_mobile
    assign class_inner_wrapper = class_inner_wrapper | append: ' flex-col '
  endunless
  if s.section_direction contains 'lg:flex-col'
    assign class_inner_wrapper = class_inner_wrapper | append: ' lg:flex-col lg:text-center lg:items-center'
  elsif s.section_direction contains 'lg:flex-row'
    assign class_inner_wrapper = class_inner_wrapper | append: ' lg:flex-row lg:text-left lg:items-start lg:justify-between'
  endif

  # Section layout for tablet breakpoint
  case s.section_layout_md
    when 'spread'
      assign class_inner_wrapper = class_inner_wrapper | append: ' md:justify-between md:text-left md:flex-row'
    when 'evenly'
      assign class_inner_wrapper = class_inner_wrapper | append: ' md:justify-evenly md:text-center md:flex-row'
    when 'centered'
      assign class_inner_wrapper = class_inner_wrapper | append: ' md:justify-center md:text-center md:flex-row md:gap-4'
    when 'stacked'
      assign class_inner_wrapper = class_inner_wrapper | append: ' md:items-center! md:flex-col md:text-center'
  endcase
  
  # Section layout for desktop breakpoint
  case s.section_layout_lg
    when 'spread'
      assign class_inner_wrapper = class_inner_wrapper | append: ' lg:justify-between lg:text-left lg:flex-row'
    when 'evenly'
      assign class_inner_wrapper = class_inner_wrapper | append: ' lg:justify-evenly lg:text-center lg:flex-row'
    when 'centered'
      assign class_inner_wrapper = class_inner_wrapper | append: ' lg:justify-center lg:text-center lg:flex-row lg:gap-4'
    when 'stacked'
      assign class_inner_wrapper = class_inner_wrapper | append: ' lg:items-center! lg:flex-col lg:text-center'
  endcase

  unless horizontal
    # Apply responsive alignment classes when not in horizontal mode
    if content_alignment
      assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_alignment
    endif
    if content_alignment_md
      assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_alignment_md
    endif
    if content_alignment_lg
      assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_alignment_lg
    endif
    
    # Apply horizontal positioning for tablet and desktop
    if content_horizontal_position_md
      assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_horizontal_position_md
    endif
    if content_horizontal_position_lg
      assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: content_horizontal_position_lg
    endif
  endunless

  unless 'header, footer, custom.overlay' contains section.location
    assign color_scheme = ' color-' | append: s.color_scheme
  endunless

  if horizontal
    assign class_inner_wrapper = class_inner_wrapper | append: ' lg:flex-row'
  endif

  if section_style == 'color_scheme'
    assign color_scheme = ' color-w-bg-' | append: s.color_scheme
    assign class_inner_wrapper = class_inner_wrapper | append: ' py-vertical-padding'
    if section_width == 'limited'
      assign class_inner_wrapper = class_inner_wrapper | append: ' lg:rounded-sm wrapper'
      comment
      assign reset_mobile_margin = true
      endcomment
    endif
  endif

  if section.location == 'header'
    assign class_outer_wrapper = class_outer_wrapper | append: ' flex'
  endif

  if block
    assign class_outer_wrapper = class_outer_wrapper | append: ' block-visibility'
  endif

  if section_width == 'limited'
    if section_style == 'color_scheme' or overlay_vertical_position != null
      assign class_outer_wrapper = class_outer_wrapper | append: ' lg:wrapper'
    else
      assign class_outer_wrapper = class_outer_wrapper | append: ' wrapper'
    endif
    assign class_inner_wrapper = class_inner_wrapper | append: color_scheme
    if s.hide_text_and_buttons != true and section_style == 'separator'
      assign class_inner_wrapper = class_inner_wrapper | append: ' border-t border-outline/20 pt-vertical-padding'
    endif
  else
    assign class_outer_wrapper = class_outer_wrapper | append: color_scheme
    if s.hide_text_and_buttons != true and section_style == 'separator'
      assign class_outer_wrapper = class_outer_wrapper | append: ' border-t border-outline pt-vertical-padding'
    endif
    unless section_style == 'none' and overlay_vertical_position contains 'overlay'
      assign class_inner_wrapper = class_inner_wrapper | append: ' wrapper'
    endunless
  endif

  assign class_inner_wrapper = class_inner_wrapper | append: ' ' | append: s.media_position | append: ' ' | append: s.media_position_lg | append: ' ' | append: s.desktop_media_width
-%}
<style>
  {% if block %}
    #block-{{ block.id }} {
  {% else %}
    #shopify-section-{{ section.id }} {
  {% endif %}
      --mobile-visibility: {% if s.show_sm != false %}block{% else %}none{% endif %};
      --tablet-visibility: {% if s.show_md != false %}block{% else %}none{% endif %};
      --desktop-visibility: {% if s.show_lg != false %}block{% else %}none{% endif %};
      {% if reset_mobile_margin %}
        --margin-top: 0;
        --margin-top-md: 0;
      {% endif %}
      {% if override_margin_top %}
        {% unless reset_mobile_margin %}
          --margin-top: {{ margin_top | divided_by: 16.0 }}rem;
          --margin-top-md: {{ margin_top_md | divided_by: 16.0 }}rem;
        {% endunless %}
        --margin-top-lg: {{ margin_top_lg | divided_by: 16.0 }}rem;
      {% endif %}
      {% if override_vertical_padding %}
        --vertical-padding: {{ vertical_padding | divided_by: 16.0 }}rem;
        --vertical-padding-md: {{ vertical_padding_md | divided_by: 16.0 }}rem;
        --vertical-padding-lg: {{ vertical_padding_lg | divided_by: 16.0 }}rem;
      {% endif %}
      {% if section_width == 'section-full' %}
        --container-width: none;
      {% endif %}
      {{ css_variables }}
    }
</style>
  <div
    class="section__outer-wrapper {{ class_outer_wrapper }} {% if block %}full-spaced-section{% endif %}"
    {% if block %}
      id="block-{{ block.id }}" {{ block.shopify_attributes -}}
    {% endif %}
  >
    <div class="section__inner-wrapper {{ class_inner_wrapper }}">
      {% if overlay_vertical_position contains 'overlay' %}
        <div class="relative w-full section__overlay-wrapper">
          {{ content }}
        </div>
      {% else %}
        {{ content }}
      {% endif %}
    {% if url != blank %}
      <a href="{{ url }}" class="absolute inset-0 z-0" aria-label="{% if s.heading != blank %}{{ s.heading }}{% else %}{{ s.button_label }}{% endif %}"
        ></a>
    {% endif %}
    </div>
  </div>
{% comment %}
  M--WRAPPER DOCUMENTATION
  ========================
  
  This wrapper supports 4 main layout types:
  1. VERTICAL - Content stacked vertically (e.g., blog posts)
  2. HORIZONTAL - Content side-by-side (e.g., image with text)
  3. OVERLAY - Text overlaid on media (e.g., hero banner)
  4. MIXED - Flexible layout switching (e.g., newsletter, countdown)
  
  Responsive Breakpoints:
  - Mobile (default): Base styles
  - Tablet (md): 768px+
  - Desktop (lg): 1024px+
  
  Key Settings:
  - content_alignment: Text alignment per breakpoint
  - content_vertical_position: Vertical positioning
  - content_horizontal_position: Horizontal positioning
  - section_layout: Overall section structure
  
  /===== VERTICAL SECTION TYPE =====/
    i.e blog posts
    - where the section can't have a horizontal or overlaid layout

