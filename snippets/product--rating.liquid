{% liquid
  assign compact = compact | default: false
  assign rating_scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
  assign initial_rating_value = 5.0
  assign initial_rating_percent = 100
  assign metafield_rating_count = product.metafields.reviews.rating_count | default: 0 | plus: 0
  assign metafield_rating_value = product.metafields.reviews.rating.value.rating | default: 0 | plus: 0
  assign has_review_hint = false
  if metafield_rating_count > 0 or metafield_rating_value > 0
    assign has_review_hint = true
  endif

  assign sku_list = ''
  for variant in product.variants
    if variant.sku != blank
      assign current_sku = variant.sku
      unless sku_list contains current_sku
        if sku_list != blank
          assign sku_list = sku_list | append: ','
        endif
        assign sku_list = sku_list | append: current_sku
      endunless
    endif
  endfor
%}

{% if compact == false or has_review_hint %}
<div
  class="flex gap-1.5 items-center {{ wrapper_class }}"
  data-product-rating-root
  data-rating-scale-max="{{ rating_scale_max }}"
  data-sku-list="{{ sku_list | escape }}"
  data-is-compact="{{ compact }}"
  data-has-review-hint="{{ has_review_hint }}"
>
  {%- unless compact -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M4.33899 11.9612C4.33899 16.1375 7.72462 19.5224 11.9009 19.5224C16.0765 19.5224 19.4622 16.1375 19.4622 11.9612C19.4622 7.78487 16.0765 4.39991 11.9009 4.39991C7.72462 4.39991 4.33899 7.78487 4.33899 11.9612ZM0 11.9993C0 5.37135 5.37268 0 12 0C18.628 0 24 5.37202 24 11.9993C24 18.6273 18.6273 24 12 24C5.37201 24 0 18.6273 0 11.9993ZM13.5184 7.52042C14.0922 7.52042 14.4035 7.95157 14.4035 8.50123C14.4035 10.3905 12.1794 11.7048 10.578 12.1828C10.9127 10.8679 11.7971 7.52042 13.5184 7.52042ZM10.8652 17.4182C12.9206 17.4182 14.451 15.9353 15.551 14.3104L14.9525 13.8558C14.1638 14.8119 13.0886 16.1033 11.7489 16.1033C10.7213 16.1033 10.2198 15.2417 10.2198 14.3104C10.2198 13.8558 10.2915 13.4019 10.3631 12.948L10.6965 12.8643C12.863 12.3247 16.6737 11.376 16.6737 8.81254C16.6737 7.30618 15.0007 6.80406 13.7574 6.80406C10.0518 6.80406 7.42267 10.2941 7.42267 13.8558C7.42267 16.0551 8.68935 17.4182 10.8652 17.4182Z" fill="#282220"/>
    </svg>
  {%- endunless -%}

  {%- if compact -%}
    <div data-product-rating-loading class="flex items-center gap-1.5">
      <span class="rounded-full block product-rating-skeleton" style="width: 68px; height: 12px; background: rgba(0,0,0,0.12);"></span>
      <span class="rounded-full block product-rating-skeleton" style="width: 28px; height: 12px; background: rgba(0,0,0,0.12);"></span>
    </div>
    <div
      role="img"
      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: initial_rating_value, rating_max: rating_scale_max }}"
      aria-hidden="true"
      data-product-rating-stars-compact
      class="
        text-ui-small
        before:content-['★★★★★']
        before:bg-clip-text
        before:[-webkit-text-fill-color:transparent]
        before:inline-block
        before:bg-(image:--rating-gradient)
        text-[#F07F06]
      "
      hidden
      style="--percent: {{ initial_rating_percent }}%; --rating-gradient: linear-gradient(90deg,currentColor var(--percent),color-mix(in srgb, currentColor 50%, transparent) var(--percent))"
    ></div>
    <span class="mt-0! text-ui-small" aria-hidden="true" data-product-rating-text-compact hidden>5.0</span>
  {%- else -%}
    <div data-product-rating-loading class="flex items-center gap-1.5">
      <span class="rounded-full block product-rating-skeleton" style="width: 88px; height: 14px; background: rgba(0,0,0,0.12);"></span>
      <span class="rounded-full block product-rating-skeleton" style="width: 104px; height: 14px; background: rgba(0,0,0,0.12);"></span>
    </div>
    <div
      role="img"
      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: initial_rating_value, rating_max: rating_scale_max }}"
      aria-hidden="true"
      data-product-rating-stars
      class="
        text-ui-small
        before:content-['★★★★★']
        before:bg-clip-text
        before:[-webkit-text-fill-color:transparent]
        before:inline-block
        before:bg-(image:--rating-gradient)
        text-[#F07F06]
      "
      hidden
      style="--percent: {{ initial_rating_percent }}%; --rating-gradient: linear-gradient(90deg,currentColor var(--percent),color-mix(in srgb, currentColor 50%, transparent) var(--percent))"
    ></div>
    <a href="#reviews" class="mt-0! text-ui-small" aria-hidden="true" data-product-rating-text hidden>
      5.0 (0 Reviews)
    </a>
  {%- endif -%}

  {% if show_rating_average %}
    <span class="text-solid-xs" data-product-rating-average hidden>
      5.0 / {{ rating_scale_max -}}
    </span>
  {% endif %}

  <span class="sr-only" data-product-rating-sr>0 {{ 'accessibility.total_reviews' | t }}</span>
</div>

<script>
  (() => {
    if (!window.__voldtInitProductRating) {
      window.__voldtInitProductRating = (scope = document) => {
        const roots = scope.querySelectorAll('[data-product-rating-root]');

        roots.forEach((root) => {
          if (root.dataset.ratingInitialized === 'true') return;
          root.dataset.ratingInitialized = 'true';

          const starsEl = root.querySelector('[data-product-rating-stars]');
          const textEl = root.querySelector('[data-product-rating-text]');
          const compactStarsEl = root.querySelector('[data-product-rating-stars-compact]');
          const compactTextEl = root.querySelector('[data-product-rating-text-compact]');
          const averageEl = root.querySelector('[data-product-rating-average]');
          const srEl = root.querySelector('[data-product-rating-sr]');
          const loadingEl = root.querySelector('[data-product-rating-loading]');
          const ratingScaleMax = Number(root.dataset.ratingScaleMax || 5);
          const skuList = root.dataset.skuList || '';
          const isCompact = root.dataset.isCompact === 'true';
          const hasReviewHint = root.dataset.hasReviewHint === 'true';

          if (!skuList) {
            root.style.display = 'none';
            return;
          }

          const setLoadingState = (isLoading) => {
            if (loadingEl) loadingEl.hidden = !isLoading;

            if (isCompact) {
              if (compactStarsEl) compactStarsEl.hidden = isLoading;
              if (compactTextEl) compactTextEl.hidden = isLoading;
            } else {
              if (starsEl) starsEl.hidden = isLoading;
              if (textEl) textEl.hidden = isLoading;
              if (averageEl) averageEl.hidden = isLoading;
            }
          };

          const hideRating = () => {
            setLoadingState(false);
            root.style.display = 'none';
          };

          const updateDisplay = (ratingValue, ratingCount) => {
            const safeRating = Number.isFinite(ratingValue) ? ratingValue : 5;
            const safeCount = Number.isFinite(ratingCount) ? ratingCount : 0;
            const ratingDisplay = safeRating.toFixed(1);
            const ratingPercent = Math.max(0, Math.min((safeRating / ratingScaleMax) * 100, 100));

            if (isCompact) {
              if (!compactStarsEl || !compactTextEl) return;
              compactStarsEl.style.setProperty('--percent', `${ratingPercent}%`);
              compactStarsEl.setAttribute('aria-label', `Rated ${ratingDisplay} out of ${ratingScaleMax} stars`);
              compactTextEl.textContent = ratingDisplay;
            } else {
              if (!starsEl || !textEl) return;
              starsEl.style.setProperty('--percent', `${ratingPercent}%`);
              starsEl.setAttribute('aria-label', `Rated ${ratingDisplay} out of ${ratingScaleMax} stars`);
              textEl.textContent = `${ratingDisplay} (${safeCount} Reviews)`;
              if (averageEl) averageEl.textContent = `${ratingDisplay} / ${ratingScaleMax}`;
            }

            if (srEl) srEl.textContent = `${safeCount} reviews`;
          };

          if (!isCompact && !hasReviewHint) {
            hideRating();
            return;
          }

          const globalState = window.__voldtProductRatings || (window.__voldtProductRatings = {
            cache: new Map(),
            inflight: new Map()
          });

          const fetchRatingData = (skuKey) => {
            if (globalState.cache.has(skuKey)) return Promise.resolve(globalState.cache.get(skuKey));
            if (globalState.inflight.has(skuKey)) return globalState.inflight.get(skuKey);

            const controller = new AbortController();
            const timeoutId = window.setTimeout(() => controller.abort(), 5000);
            const apiUrl = `https://app-dev.voldt.com/api/shopify/reviews/${skuKey}&rating=4,5`;

            const request = fetch(apiUrl, {
              method: 'GET',
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              signal: controller.signal
            })
              .then((response) => (response.ok ? response.json() : null))
              .then((data) => {
                const payload = { items: Array.isArray(data?.items) ? data.items : [] };
                globalState.cache.set(skuKey, payload);
                return payload;
              })
              .catch(() => ({ items: [] }))
              .finally(() => {
                window.clearTimeout(timeoutId);
                globalState.inflight.delete(skuKey);
              });

            globalState.inflight.set(skuKey, request);
            return request;
          };

          const runFetch = () => {
            setLoadingState(true);

            fetchRatingData(skuList).then((payload) => {
              const items = payload.items;
              if (!items.length) {
                hideRating();
                return;
              }

              let reviewSum = 0;
              for (const item of items) {
                const parsedRating = Number.parseFloat(item?.rating) || 0;
                reviewSum += parsedRating;
              }

              updateDisplay(reviewSum / items.length, items.length);
              setLoadingState(false);
            });
          };

          if (isCompact && 'IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              const [entry] = entries;
              if (!entry?.isIntersecting) return;
              observer.disconnect();
              runFetch();
            }, { rootMargin: '120px 0px' });

            observer.observe(root);
          } else {
            runFetch();
          }
        });
      };
    }

    window.__voldtInitProductRating(document);
  })();
</script>
<style>
  .product-rating-skeleton {
    animation: product-rating-skeleton-pulse 1.2s ease-in-out infinite;
  }

  @keyframes product-rating-skeleton-pulse {
    0% {
      opacity: 0.45;
    }
    50% {
      opacity: 0.9;
    }
    100% {
      opacity: 0.45;
    }
  }
</style>
{% endif %}
