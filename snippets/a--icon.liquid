{%- doc -%}
  Icon component for displaying SVG icons with customizable styling and animations.

  This component provides a comprehensive set of icons including social media, navigation, UI elements, e-commerce specific icons, and loading states. Icons are rendered as inline SVG with customizable colors, size scale, and stroke widths. Size and stroke use responsive design tokens (mobile first, overridden at lg).

  @param {string} icon - The icon name to display (required)
  @param {string} [class] - Additional CSS classes to apply to the SVG element
  @param {string} [color] - Icon color (defaults to 'currentColor')
  @param {string} [size] - Size scale: xxs, xs, sm, base, lg, xl (defaults to 'base'). Uses responsive icon tokens; maps to stroke (xxs/xs→sm, sm/base→base, lg→lg, xl→xl). Ignored if width or height is set.
  @param {string} [width] - Icon width (e.g. '1.5rem'). When set, overrides size scale for dimensions and allows explicit rem/pixel sizing.
  @param {string} [height] - Icon height (defaults to width when set). When set with width, overrides size scale for dimensions.
  @param {string} [stroke] - Stroke width classes (e.g. 'stroke-sm', 'stroke-base'). When set, overrides the stroke implied by size. When using size scale only, stroke is derived from size (default stroke from size).
  @param {boolean} [animate] - Whether to apply animation classes for interactive states
  @param {string} [viewBox] - Optional SVG viewBox override (defaults to '0 0 24 24')
  @param {string} [aria_label] - Screen reader text for the icon (optional)
  @param {boolean} [aria_hidden] - Whether to hide from screen readers (defaults to true if no aria_label)
  @param {string} [role] - ARIA role for the icon (optional)
  @param {string} [props] - Additional SVG attributes (optional)

  @example
  {% render 'a--icon', icon: 'search' %}
  @example
  {% render 'a--icon', icon: 'chevron-d', size: 'lg' %}
  @example
  {% render 'a--icon', 
      class: 'hover:opacity-50',
      icon: 'chevron-d', 
      color: '#000000', 
      stroke: 'stroke-lg',
      width: '2.25rem', 
      height: '2.25rem',
      animate: true 
  %}
  @example
  {% render 'a--icon',
      icon: 'search',
      aria_label: 'Search products',
      aria_hidden: false
  %}
{%- enddoc -%}

{% if icon %}
{%- liquid
  assign color = color | default: 'currentColor'
  assign viewBox = viewBox | default: '0 0 24 24'
  assign size = size | default: 'base'

  # Use scale (inline style with CSS var) for dimensions when width/height unset.
  # Inline style avoids dynamic icon-* class names that Tailwind cannot see for purging.
  assign use_scale = false
  if width == blank and height == blank
    assign use_scale = true
  endif

  if use_scale
    comment
      Icon sizes use rem-based spacing tokens. This project also uses a responsive `--rem-base`
      (vw-driven on small screens), which can make icons look oversized on mobile/tablet.
      Cap scale-based icon sizes to their "design px" maxima so they don't balloon with rem-base.
    endcomment
    assign size_max_px = ''
    case size
      when 'xxs'
        assign size_max_px = '12px'
      when 'xs'
        assign size_max_px = '16px'
      when 'sm'
        assign size_max_px = '20px'
      when 'base'
        assign size_max_px = '24px'
      when 'lg'
        assign size_max_px = '32px'
      when 'xl'
        assign size_max_px = '48px'
    endcase

    if size_max_px != ''
      assign size_style = 'width: min(var(--height-icon-' | append: size | append: '), ' | append: size_max_px | append: '); height: min(var(--height-icon-' | append: size | append: '), ' | append: size_max_px | append: ');'
    else
      assign size_style = 'width: var(--height-icon-' | append: size | append: '); height: var(--height-icon-' | append: size | append: ');'
    endif
  else
    assign size_style = ''
    assign width = width | default: height
    assign height = height | default: width
  endif

  # Stroke: explicit param overrides; else derive from size (xxs/xs→sm, sm/base→base, lg→lg, xl→xl)
  if stroke != blank
    assign stroke_class = stroke
  else
    case size
      when 'xxs', 'xs'
        assign stroke_class = 'stroke-sm'
      when 'sm', 'base'
        assign stroke_class = 'stroke-base'
      when 'lg'
        assign stroke_class = 'stroke-lg'
      when 'xl'
        assign stroke_class = 'stroke-xl'
      else
        assign stroke_class = 'stroke-base'
    endcase
  endif

  # If animate is true, add a class to the icon based on the icon name
  if animate
    case icon
      when 'plus'
        assign class = class | append: ' [[open]_>_summary_&_path:first-child]:rotate-270 [.animate-icon_>_&_path:first-child]:rotate-270  [&_path]:origin-center'
        comment
          assign class = class | append: ' [&_path]:duration-500 [&_path]:transition-transform'
        endcomment
      when 'chevron-d'
        assign class = class | append: ' transition-transform [&_path]:duration-300 [&_path]:transition-transform'
        assign class = class | append: ' [[open]_>_summary_&]:rotate-180'
      when 'menu'
        assign class = class | append: ' transition-transform [&_path]:duration-300 [&_path]:transition-transform'
        assign class = class | append: ' [&_path]:ease-in-out [[aria-expanded=true]_&_path:nth-child(1)]:rotate-[42deg] [[aria-expanded=true]_&_path:nth-child(1)]:translate-x-[8px] [[aria-expanded=true]_&_path:nth-child(2)]:opacity-0 [[aria-expanded=true]_&_path:nth-child(3)]:-rotate-[42deg] [[aria-expanded=true]_&_path:nth-child(3)]:translate-y-[8.5px] [[aria-expanded=true]_&_path:nth-child(3)]:-translate-x-[8px]'
      when 'spinner'
        assign class = class | append: ' animate-spin'
    endcase
  endif

  # Set default aria-hidden based on whether aria_label is provided
  unless aria_label
    assign aria_hidden = aria_hidden | default: true
  else
    assign aria_hidden = aria_hidden | default: false
  endunless

  capture props
    echo props | append: ' '
    if aria_hidden
      echo 'aria-hidden="true"'
    endif
    if aria_label
      echo 'aria-label="' | append: aria_label | append: '"'
    endif
    if role
      echo 'role="' | append: role | append: '"'
    endif
  endcapture
-%}
<svg
  {{ props }}
  class="shrink-0 {{ class }} {{ stroke_class }}"
  {% if use_scale %}style="{{ size_style }}"{% else %}width="{{ width }}" height="{{ height }}"{% endif %}
  viewBox="{{ viewBox }}"
  fill="none"
>
  {%- case icon -%}

