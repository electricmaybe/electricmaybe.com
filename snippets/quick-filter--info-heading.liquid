    if display_label == blank
      assign display_label = lookup_key | replace: '-', ' ' | replace: '_', ' ' | strip | capitalize
    endif
  -%}

  <drawer-trigger data-target="{{ drawer_id }}" class="{{ trigger_class }}">
    <span class="{{ label_class }}">{{ display_label }}</span>
    {%- render 'a--icon', icon: 'info-fill', width: '1rem' -%}
  </drawer-trigger>

