          class="inline-flex items-center justify-center rounded-full bg-accent text-on-accent w-12 h-12 md:w-14 md:h-14 hover:opacity-85 transition-opacity"
          aria-label="Close filters"
        >
          {% render 'a--icon', icon: 'arrow-left-l', width: '1.25rem' %}
        </drawer-trigger>
        <h3 class="h3 text-primary">
          {{ display_label }}
        </h3>
      </div>

