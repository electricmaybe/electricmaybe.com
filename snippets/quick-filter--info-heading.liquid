        {%- if info_description != blank -%}
            {{ info_description }}
        {%- endif -%}

      {%- capture faq_items -%}
        {%- liquid
          assign seen = '||'
          assign faq_index = 0

          if info_faqs != blank
            for faq_obj in info_faqs
              if faq_obj == blank
                continue
              endif

              assign faq_key = faq_obj.system.handle | default: faq_obj.system.id | default: faq_obj.question | default: '' | append: ''
              assign faq_key = '||' | append: faq_key | append: '||'
              if seen contains faq_key
                continue
              endif
              assign seen = seen | append: faq_key

              assign faq_index = faq_index | plus: 1
              assign faq_q = faq_obj.question | default: faq_obj.question.value | default: faq_obj.question_text | default: ''
              assign faq_a = faq_obj.answer | metafield_tag
