{%- doc -%}
  Price Range Filter Component
  
  Native dual-range slider using overlapped HTML range inputs.
  Achieves 90% code reduction vs custom implementation.
  
  @param filter {Object} Filter object from collection.filters (required)
  @param input_prefix {String} Prefix for input IDs to ensure uniqueness (default: 'desktop')
  
  @example
    {% render 'filter--price-range',
      filter: filter,
      input_prefix: 'desktop'
    %}
    
  @example
    {% render 'filter--price-range',
      filter: filter,
      input_prefix: 'mobile'
    %}
    
  Test cases:
  - Filter with no active values (shows full range)
  - Filter with min value only
  - Filter with max value only  
  - Filter with both min and max values
  - Filter at currency limits (0 to max)
{%- enddoc -%}

{%- liquid
  # Parameter validation and defaults
  assign filter = filter | default: empty
  assign input_prefix = input_prefix | default: 'desktop'
  
  # Early return if required parameters missing
  unless filter != empty
    echo '<!-- Error: filter parameter required for filter--price-range snippet -->'
    break
  endunless
  
  # Calculate values
  assign min_value = filter.min_value.value | default: 0.0 | divided_by: 100.0
  assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
  assign range_max = filter.range_max | divided_by: 100.0 | ceil
  assign lower_bound_progress = min_value | divided_by: range_max | times: 100.0
  assign higher_bound_progress = max_value | divided_by: range_max | times: 100.0

  assign range_slider_class = 'price-range-slider appearance-none bg-transparent pointer-events-none w-full absolute inset-0 focus:outline-none'
  assign number_input_class = 'price-range-input w-full px-2 py-1 text-sm border border-secondary rounded-sm bg-subtle focus:outline-none focus:border-primary'
-%}

<price-range class="grid gap-4 pt-2">
  {%- comment -%} Dual range slider with visual track {%- endcomment -%}
  <div class="price-range-track relative h-0.5 bg-emphasis rounded-full" style="--range-min: {{ lower_bound_progress }}%; --range-max: {{ higher_bound_progress }}%">
    <div class="price-range-active absolute inset-0 rounded-full"></div>
    
    <input 
      type="range" 
      aria-label="{{ 'collections.faceting.price_filter_from' | t }}" 
      class="{{ range_slider_class }} from"
      min="0" 
      max="{{ range_max | ceil }}" 
      value="{{ min_value | ceil }}">
    
    <input 
      type="range" 
      aria-label="{{ 'collections.faceting.price_filter_to' | t }}" 
      class="{{ range_slider_class }} to"
      min="0" 
      max="{{ range_max | ceil }}" 
      value="{{ max_value | ceil }}">
  </div>
  
  {%- comment -%} Text inputs for manual entry {%- endcomment -%}
  <div class="price-range-inputs flex items-center gap-3">
    <label class="flex items-center gap-1 text-sm w-full">
      <span class="opacity-50">{{ cart.currency.symbol }}</span>
      <input 
        aria-label="{{ 'collections.faceting.price_filter_from' | t }}" 
        class="{{ number_input_class }}"
        type="number" 
        inputmode="numeric" 
        {% if filter.min_value.value %}value="{{ min_value | ceil }}"{% endif %} 
        name="{{ filter.min_value.param_name }}" 
        id="{{ input_prefix }}-{{ filter.min_value.param_name }}" 
        min="0" 
        max="{{ max_value | ceil }}" 
        placeholder="0" 
        autocomplete="off">
    </label>
    
    <span class="opacity-50 text-sm">{{ 'collections.faceting.price_range_to' | t | default: 'to' }}</span>
    
    <label class="flex items-center gap-1 text-sm w-full">
      <span class="opacity-50">{{ cart.currency.symbol }}</span>
      <input 
        aria-label="{{ 'collections.faceting.price_filter_to' | t }}" 
        class="{{ number_input_class }}"
        type="number" 
        inputmode="numeric" 
        {% if filter.max_value.value %}value="{{ max_value | ceil }}"{% endif %} 
        name="{{ filter.max_value.param_name }}" 
        id="{{ input_prefix }}-{{ filter.max_value.param_name }}" 
        min="{{ min_value | ceil }}" 
        max="{{ range_max | ceil }}" 
        placeholder="{{ range_max | ceil }}" 
        autocomplete="off">
    </label>
  </div>
</price-range>

{%- if filter.min_value.value != null or filter.max_value.value != null -%}
  <a
    href="{{ filter.url_to_remove }}"
    class="inline-block mt-4 w-full text-center text-sm underline"
    data-filter-remove
    data-filter-param="price"
    data-filter-value="all"
  >
    {{ 'products.facets.reset' | t }}
  </a>
{%- endif -%}